# Line-ending policy: Windows source is CRLF in the working tree, LF in the
# object database, so diffs stay stable across editors and CI runners.
* text=auto

*.cs          text eol=crlf
*.csproj      text eol=crlf
*.props       text eol=crlf
*.targets     text eol=crlf
*.config      text eol=crlf
*.manifest    text eol=crlf
*.resx        text eol=crlf
*.sln         text eol=crlf
*.slnx        text eol=crlf
*.xaml        text eol=crlf
*.bat         text eol=crlf
*.ps1         text eol=crlf

*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.json        text eol=lf
*.csv         text eol=lf
*.sql         text eol=lf
*.py          text eol=lf
*.editorconfig text eol=lf
.gitattributes text eol=lf

# Binary: never diff, never merge textually
*.png binary
*.jpg binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
*.so binary
*.dylib binary
*.LOG -text diff

# Generated ledgers: resolve conflicts by regenerating, not by merging
artifacts/*.csv linguist-generated=true
artifacts/*.json linguist-generated=true
docs/inventory/*.md linguist-generated=true
docs/12-service-activation-status.csv linguist-generated=true
