        private void BuildTabSettings()
        {
            var scroll = new Panel { Dock = DockStyle.Fill, AutoScroll = true, Padding = new Padding(20, 15, 20, 15), BackColor = LightUiTheme.Window };

            // مجموعة الاتصال
            var grpConn = new GroupBox { Text = "إعدادات الاتصال", Dock = DockStyle.Top, Height = 120, ForeColor = LightUiTheme.Text, BackColor = LightUiTheme.Window, Padding = new Padding(10) };
