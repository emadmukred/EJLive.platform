                BackColor = LightUiTheme.Window,
                ForeColor = LightUiTheme.Text,
                Padding = new Padding(10)
            };
            _dgvPendingCmds = CreateDataGrid();
            _dgvPendingCmds.Columns.AddRange(new DataGridViewColumn[]
            {
                new DataGridViewTextBoxColumn { HeaderText = "الأمر", Width = 130 },
                new DataGridViewTextBoxColumn { HeaderText = "المعرف", Width = 90 },
                new DataGridViewTextBoxColumn { HeaderText = "الحالة", Width = 90 },
                new DataGridViewTextBoxColumn { HeaderText = "الوقت", Width = 90 },
                new DataGridViewTextBoxColumn { HeaderText = "النتيجة", AutoSizeMode = DataGridViewAutoSizeColumnMode.Fill }
            });
            cmdGroup.Controls.Add(_dgvPendingCmds);

            opsPanel.Controls.Add(cmdGroup);
            opsPanel.Controls.Add(windowsGroup);
            opsPanel.Controls.Add(servicesGroup);
            split.Panel2.Controls.Add(opsPanel);

            host.Controls.Add(split);
            _tabServices.Controls.Add(host);
            UpdateServiceStatuses();
            RunWindowsDiagnostics();
        }

        private void ApplyServicesSplitterLayout(SplitContainer split)
        {
            if (split == null || split.IsDisposed) return;
            const int preferredPanel1Min = 260;
            const int preferredPanel2Min = 220;

            if (split.Width <= preferredPanel1Min + preferredPanel2Min + split.SplitterWidth)
                return;

            if (split.Panel1MinSize != preferredPanel1Min)
                split.Panel1MinSize = preferredPanel1Min;
            if (split.Panel2MinSize != preferredPanel2Min)
                split.Panel2MinSize = preferredPanel2Min;

            var min = preferredPanel1Min;
            var max = split.Width - preferredPanel2Min - split.SplitterWidth;
            if (max <= min) return;

            var target = (int)(split.Width * 0.62);
            target = Math.Max(min, Math.Min(max, target));

            if (split.SplitterDistance != target)
                split.SplitterDistance = target;
        }

        private void AddServiceHeader(TableLayoutPanel table)
        {
            table.Controls.Add(new Label { Text = "الخدمة", Dock = DockStyle.Fill, Font = new Font("Segoe UI", 9f, FontStyle.Bold), TextAlign = ContentAlignment.MiddleLeft }, 0, 0);
            table.Controls.Add(new Label { Text = "تشغيل", Dock = DockStyle.Fill, Font = new Font("Segoe UI", 9f, FontStyle.Bold), TextAlign = ContentAlignment.MiddleCenter }, 1, 0);
            table.Controls.Add(new Label { Text = "إيقاف", Dock = DockStyle.Fill, Font = new Font("Segoe UI", 9f, FontStyle.Bold), TextAlign = ContentAlignment.MiddleCenter }, 2, 0);
            table.Controls.Add(new Label { Text = "الحالة", Dock = DockStyle.Fill, Font = new Font("Segoe UI", 9f, FontStyle.Bold), TextAlign = ContentAlignment.MiddleCenter }, 3, 0);
        }

        private void AddServiceRow(TableLayoutPanel table, int row, string key, string name, Action start, Action stop, Func<bool> isRunning, string runningText, string stoppedText)
        {
            var title = new Label { Text = name, Dock = DockStyle.Fill, TextAlign = ContentAlignment.MiddleLeft, Font = new Font("Segoe UI", 8.7f, FontStyle.Regular) };
            var startBtn = MakeButton("Start", Color.FromArgb(68, 176, 90), () => { start?.Invoke(); UpdateServiceStatuses(); }, 78);
            var stopBtn = MakeButton("Stop", Color.FromArgb(244, 67, 54), () => { stop?.Invoke(); UpdateServiceStatuses(); }, 78);
            var status = new Label { Dock = DockStyle.Fill, Text = $"[OFF] {stoppedText}", ForeColor = LightUiTheme.Muted, TextAlign = ContentAlignment.MiddleCenter };
            table.Controls.Add(title, 0, row);
            table.Controls.Add(startBtn, 1, row);
            table.Controls.Add(stopBtn, 2, row);
            table.Controls.Add(status, 3, row);

            _serviceRows[key] = new ServiceRowState
            {
                StatusLabel = status,
                StartButton = startBtn,
                StopButton = stopBtn,
                IsRunning = isRunning,
                RunningText = runningText,
                StoppedText = stoppedText
            };
        }

