        public ClientMainForm()
        {
            if (IsVisualStudioDesigner())
            {
                InitializeDesignerPreview();
                return;
            }

            _config = AgentConfigurationXmlService.LoadAppConfig(AppConfig.Load());
            InitializeServices();
            InitializeForm();
            InitializeMenuStrip();
            InitializeStatusStrip();
            InitializeTabs();
            InitializeTimer();
            LoadSettingsToUI();

            if (_config.AutoConnect) BeginConnect();
        }

        private static bool IsVisualStudioDesigner()
        {
            if (System.ComponentModel.LicenseManager.UsageMode == System.ComponentModel.LicenseUsageMode.Designtime)
                return true;

            var processName = System.Diagnostics.Process.GetCurrentProcess().ProcessName;
            return processName.IndexOf("devenv", StringComparison.OrdinalIgnoreCase) >= 0
                || processName.IndexOf("DesignToolsServer", StringComparison.OrdinalIgnoreCase) >= 0
                || processName.IndexOf("XDesProc", StringComparison.OrdinalIgnoreCase) >= 0;
        }

        private void InitializeDesignerPreview()
        {
            InitializeComponent();
            Text = "EJLive Enterprise Client v4.0.0 - Design Preview";
            Size = new Size(1050, 760);
            MinimumSize = new Size(900, 600);
            BackColor = LightUiTheme.Window;
            ForeColor = LightUiTheme.Text;
            Font = new Font("Segoe UI", 9.5f);
            Controls.Clear();

            var notice = new Label
            {
                Dock = DockStyle.Top,
                Height = 42,
                Text = "معاينة المصمم: واجهة التشغيل الفعلية مبنية بالكود في ClientMainForm.cs",
                TextAlign = ContentAlignment.MiddleCenter,
                BackColor = LightUiTheme.SurfaceAlt,
                ForeColor = LightUiTheme.Muted,
                Font = new Font("Segoe UI", 9f, FontStyle.Bold)
            };

            var menu = new MenuStrip { BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text };
            menu.Items.AddRange(new ToolStripItem[] { new ToolStripMenuItem("ملف"), new ToolStripMenuItem("أدوات") });

            var tabs = new TabControl
            {
                Dock = DockStyle.Fill,
                Font = new Font("Segoe UI", 9f, FontStyle.Bold),
                Padding = new Point(14, 5)
            };

            tabs.TabPages.Add(CreateDesignerPreviewTab("الاتصال", "حالة الاتصال، الجلسة، السرعة، وسجل الاتصال"));
            tabs.TabPages.Add(CreateDesignerPreviewTab("المزامنة", "طابور الملفات، تقدم الإرسال، وإحصائيات النجاح"));
            tabs.TabPages.Add(CreateDesignerPreviewTab("الجورنال", "عرض وتحليل سجلات EJ والبحث داخلها"));
            tabs.TabPages.Add(CreateDesignerPreviewTab("التحكم البعيد", "Ghost View والأوامر المستلمة من الخادم"));
            tabs.TabPages.Add(CreateDesignerPreviewTab("الخدمات", "تشغيل وإيقاف خدمات العميل"));
            tabs.TabPages.Add(CreateDesignerPreviewTab("الإعدادات", "إعدادات الاتصال والصراف والمسارات"));
            tabs.TabPages.Add(CreateDesignerPreviewTab("Agent Config", "قراءة AgentConf.xml وربطه بإعدادات التشغيل"));

            var status = new StatusStrip { BackColor = LightUiTheme.Surface, SizingGrip = false };
            status.Items.Add(new ToolStripStatusLabel("● معاينة فقط") { ForeColor = LightUiTheme.Muted });

            Controls.Add(tabs);
            Controls.Add(notice);
            Controls.Add(menu);
            Controls.Add(status);
        }

        private static TabPage CreateDesignerPreviewTab(string title, string description)
        {
            var tab = new TabPage(title) { BackColor = LightUiTheme.Window };
            var label = new Label
            {
                Dock = DockStyle.Fill,
                Text = description,
                TextAlign = ContentAlignment.MiddleCenter,
                ForeColor = LightUiTheme.Text,
                Font = new Font("Segoe UI", 12f, FontStyle.Bold)
            };
            tab.Controls.Add(label);
            return tab;
        }

        private void InitializeServices()
        {
            AppLogger.Instance.Initialize(AppConstants.DefaultLogPath, "client");
            AppLogger.Instance.OnLog += (s, e) => AppendConnLog(e.FormattedForUI, e.Level);
            _config = AgentConfigurationXmlService.LoadAppConfig(_config);
            _agentConfig = AgentConfigurationXmlService.LoadOrCreate(_config);
            _config.ApplyDefaults();
            EnsureClientRuntimeFolders();
            _config.Save();
            DatabaseManager.Instance.Initialize(AppConstants.DefaultDatabasePath);

            _analysisEngine = new TransactionAnalysisEngine();
            _atmInfo        = new ATMInfo
            {
                ATM_ID      = _config.ATM_ID,
                ATM_Name    = _config.ATM_Name,
                ATM_Type    = _config.ATM_Type,
                NetworkType = _config.NetworkType,
                ServerIP    = _config.ServerIP,
                ServerPort  = _config.ServerPort
            };
        }

        private void InitializeForm()
        {
            Text          = $"EJLive Enterprise Client — {_config.ATM_ID}";
            Size          = new Size(1050, 760);
            MinimumSize   = new Size(900, 600);
            StartPosition = FormStartPosition.CenterScreen;
            BackColor     = LightUiTheme.Window;
            ForeColor     = LightUiTheme.Text;
            Font          = new Font("Segoe UI", 9.5f);
        }

        private void InitializeMenuStrip()
        {
            _menuStrip = new MenuStrip { BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text };
            var fileMenu = new ToolStripMenuItem("ملف");
            fileMenu.DropDownItems.AddRange(new ToolStripItem[]
            {
                new ToolStripMenuItem("اتصال",     null, (s,e) => BeginConnect()),
                new ToolStripMenuItem("قطع الاتصال", null, (s,e) => DisconnectNow()),
                new ToolStripSeparator(),
                new ToolStripMenuItem("خروج", null, (s,e) => Close())
            });
            var toolsMenu = new ToolStripMenuItem("أدوات");
            toolsMenu.DropDownItems.AddRange(new ToolStripItem[]
            {
                new ToolStripMenuItem("فتح مجلد الجورنال", null, OnOpenJournalFolder),
                new ToolStripMenuItem("فتح مجلد السجل",    null, OnOpenLogFolder),
                new ToolStripSeparator(),
                new ToolStripMenuItem("اختبار الاتصال",   null, OnPing)
            });
            _menuStrip.Items.AddRange(new[] { fileMenu, toolsMenu });
            Controls.Add(_menuStrip);
        }

        private void InitializeStatusStrip()
        {
            _statusStrip = new StatusStrip { BackColor = LightUiTheme.Surface, SizingGrip = false };
            _lblStatus    = new ToolStripStatusLabel("● غير متصل") { ForeColor = Color.FromArgb(255, 69, 58) };
            _lblSpeed     = new ToolStripStatusLabel("السرعة: —") { ForeColor = Color.FromArgb(99, 99, 102) };
            _lblSyncState = new ToolStripStatusLabel("المزامنة: —") { ForeColor = Color.FromArgb(99, 99, 102) };
            _lblTime      = new ToolStripStatusLabel { Alignment = ToolStripItemAlignment.Right, ForeColor = Color.FromArgb(99, 99, 102) };
            _statusStrip.Items.AddRange(new ToolStripItem[] { _lblStatus, new ToolStripSeparator(), _lblSpeed, new ToolStripSeparator(), _lblSyncState, _lblTime });
            Controls.Add(_statusStrip);
        }

        private void InitializeTabs()
        {
            _tabMain = new TabControl
            {
                Dock               = DockStyle.None,
                DrawMode           = TabDrawMode.Normal,
                ItemSize           = new Size(150, 32),
                SizeMode           = TabSizeMode.Normal,
                Font               = new Font("Segoe UI", 9f, FontStyle.Bold),
                Padding            = new Point(14, 5),
                RightToLeft        = RightToLeft.No,
                RightToLeftLayout  = false
            };

            _tabConnection = new TabPage("الاتصال");
            _tabSync       = new TabPage("المزامنة");
            _tabJournal    = new TabPage("الجورنال");
            _tabRemote     = new TabPage("التحكم البعيد");
            _tabServices   = new TabPage("الخدمات");
            _tabSettings   = new TabPage("الإعدادات");
            _tabAgentConfig = new TabPage("Agent Config");

            _tabServices.Text = "الخدمات والتحكم";

            foreach (var t in new[] { _tabConnection, _tabSync, _tabJournal, _tabRemote, _tabServices, _tabSettings, _tabAgentConfig })
                t.BackColor = LightUiTheme.Window;

            BuildTabConnection();
            BuildTabSync();
            BuildTabJournal();
            BuildTabServices();
            BuildTabRemote();
            BuildTabSettingsModern();
            BuildTabAgentConfig();

            _tabMain.TabPages.AddRange(new[] { _tabConnection, _tabSync, _tabJournal, _tabRemote, _tabServices, _tabSettings, _tabAgentConfig });
            Controls.Add(_tabMain);
            _menuStrip.BringToFront();
            _statusStrip.BringToFront();
            LayoutMainRegions();
            Resize += (s, e) => LayoutMainRegions();
            LightUiTheme.Apply(this);
            ApplyClientVisualCorrections();
        }

