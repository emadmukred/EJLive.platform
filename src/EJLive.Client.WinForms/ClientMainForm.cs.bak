        // TAB 1 — الاتصال
        // ═══════════════════════════════════════════

        private void BuildTabConnection()
        {
            // مؤشر الاتصال الكبير
            _pnlConnStatus = new Panel { Height = 124, Dock = DockStyle.Top, BackColor = LightUiTheme.Surface, Padding = new Padding(20) };
            _lblConnIndicator = new Label
            {
                Text      = "●",
                Font      = new Font("Segoe UI", 24f, FontStyle.Bold),
                ForeColor = LightUiTheme.Muted,
                AutoSize  = true,
                Location  = new Point(24, 30)
            };
            _lblConnText = new Label
            {
                Text      = "غير متصل",
                Font      = new Font("Segoe UI", 20f, FontStyle.Bold),
                ForeColor = LightUiTheme.Danger,
                AutoSize  = true,
                Location  = new Point(78, 26)
            };
            _lblSessionId = new Label { Text = "Session: —", AutoSize = true, ForeColor = LightUiTheme.Muted, Location = new Point(78, 74), Font = new Font("Segoe UI", 9f) };
            _lblLatency   = new Label { Text = "—", AutoSize = true, ForeColor = LightUiTheme.Muted, Location = new Point(280, 74) };
            _pnlConnStatus.Controls.AddRange(new Control[] { _lblConnIndicator, _lblConnText, _lblSessionId, _lblLatency });

            // أزرار الاتصال
            var btnRow = new FlowLayoutPanel { Height = 58, Dock = DockStyle.Top, FlowDirection = FlowDirection.LeftToRight, WrapContents = true, Padding = new Padding(16, 10, 16, 8), BackColor = LightUiTheme.SurfaceAlt };
            _btnConnect    = MakeButton("اتصال",       LightUiTheme.Success, BeginConnect, 130);
            _btnDisconnect = MakeButton("قطع الاتصال", LightUiTheme.Danger,  DisconnectNow, 150);
            SetButtonVisual(_btnDisconnect, LightUiTheme.Danger, false);
            btnRow.Controls.AddRange(new Control[] { _btnConnect, _btnDisconnect });

            // شريط التقدم
            _pnlConnProgress = new Panel { Height = 42, Dock = DockStyle.Top, BackColor = LightUiTheme.Surface };
            _pbConnProgress  = new ProgressBar { Width = 400, Height = 18, Location = new Point(16, 12), Style = ProgressBarStyle.Marquee, MarqueeAnimationSpeed = 0 };
            _lblConnProgress = new Label { Text = "", AutoSize = true, ForeColor = LightUiTheme.Primary, Location = new Point(440, 11), Font = new Font("Segoe UI", 9f, FontStyle.Bold) };
            _pnlConnProgress.Controls.AddRange(new Control[] { _pbConnProgress, _lblConnProgress });

            // معلومات الجلسة
            _pnlConnMeta = new Panel { Height = 64, Dock = DockStyle.Top, BackColor = LightUiTheme.SurfaceAlt, Padding = new Padding(16, 12, 16, 8) };
            var metaFlow = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.LeftToRight, WrapContents = true, BackColor = LightUiTheme.SurfaceAlt };
            _lblConnectedSince = MakeMeta("متصل منذ:", "—");
            _lblBytesSent      = MakeMeta("بايتات أُرسلت:", "0 KB");
            _lblBytesRecv      = MakeMeta("بايتات مُستلمة:", "0 KB");
            metaFlow.Controls.AddRange(new Control[] { _lblConnectedSince, _lblBytesSent, _lblBytesRecv });
            _pnlConnMeta.Controls.Add(metaFlow);

            // سجل الاتصال
            _rtbConnLog = new RichTextBox
            {
                Dock        = DockStyle.Fill,
                BackColor   = LightUiTheme.Surface,
                ForeColor   = LightUiTheme.Text,
                Font        = new Font("Segoe UI", 9f),
                ReadOnly    = true,
                BorderStyle = BorderStyle.FixedSingle,
                ScrollBars  = RichTextBoxScrollBars.Vertical,
                RightToLeft = RightToLeft.No
            };

            _pnlLocalState = BuildLocalStatePanel();
            _tabConnection.Controls.AddRange(new Control[] { _rtbConnLog, _pnlLocalState, _pnlConnMeta, _pnlConnProgress, btnRow, _pnlConnStatus });
            RefreshLocalStateReading(false);
        }

        private Panel _pnlConnProgress;

        private Panel BuildLocalStatePanel()
        {
            var panel = new Panel
            {
                Height = 210,
                Dock = DockStyle.Top,
                BackColor = LightUiTheme.Surface,
                Padding = new Padding(12, 8, 12, 10)
            };

            _lblLocalStateSummary = new Label
            {
                Dock = DockStyle.Top,
                Height = 30,
                Text = "قراءة الحالات المحلية: —",
                ForeColor = LightUiTheme.Muted,
                Font = new Font("Segoe UI", 9.4f, FontStyle.Bold),
                TextAlign = ContentAlignment.MiddleLeft
            };

            _dgvLocalState = CreateDataGrid();
            _dgvLocalState.Dock = DockStyle.Fill;
            _dgvLocalState.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.None;
            _dgvLocalState.Columns.AddRange(new DataGridViewColumn[]
            {
                new DataGridViewTextBoxColumn { HeaderText = "المجال", Width = 135 },
                new DataGridViewTextBoxColumn { HeaderText = "الحالة", Width = 105 },
                new DataGridViewTextBoxColumn { HeaderText = "القراءة اللحظية", Width = 330 },
                new DataGridViewTextBoxColumn { HeaderText = "الإجراء المحلي", AutoSizeMode = DataGridViewAutoSizeColumnMode.Fill }
            });

            panel.Controls.Add(_dgvLocalState);
            panel.Controls.Add(_lblLocalStateSummary);
            return panel;
        }

        // ═══════════════════════════════════════════
        // TAB 2 — المزامنة
        // ═══════════════════════════════════════════

        private void BuildTabSync()
        {
            // شريط التقدم الحي
            _pnlSyncProgress = new Panel { Height = 80, Dock = DockStyle.Top, BackColor = LightUiTheme.Surface, Padding = new Padding(12) };
            _pbSyncProgress  = new ProgressBar { Width = 500, Height = 22, Location = new Point(12, 12), Minimum = 0, Maximum = 100 };
            _lblSyncFile     = new Label { Text = "—", AutoSize = true, ForeColor = LightUiTheme.Primary, Location = new Point(12, 42) };
            _lblSyncPercent  = new Label { Text = "0%", AutoSize = true, ForeColor = LightUiTheme.Text, Font = new Font("Segoe UI", 11f, FontStyle.Bold), Location = new Point(520, 10) };
            _pnlSyncProgress.Controls.AddRange(new Control[] { _pbSyncProgress, _lblSyncFile, _lblSyncPercent });

            _pnlSyncTimeline = new Panel { Height = 48, Dock = DockStyle.Top, BackColor = LightUiTheme.SurfaceAlt, Padding = new Padding(12, 8, 12, 6) };
            var timelineFlow = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.LeftToRight, WrapContents = false, BackColor = LightUiTheme.SurfaceAlt };
            var steps = new[] { "قراءة المصدر", "نسخة محلية", "طابور", "إرسال", "تحقق الخادم" };
            for (int i = 0; i < steps.Length; i++)
            {
                _syncStepLabels[i] = new Label
                {
                    Text = steps[i],
                    Width = 128,
                    Height = 28,
                    Margin = new Padding(4, 2, 4, 2),
                    TextAlign = ContentAlignment.MiddleCenter,
                    BackColor = i == 0 ? LightUiTheme.Primary : LightUiTheme.Surface,
                    ForeColor = i == 0 ? Color.White : LightUiTheme.Muted,
                    BorderStyle = BorderStyle.FixedSingle,
                    Font = new Font("Segoe UI", 8.4f, FontStyle.Bold)
                };
                timelineFlow.Controls.Add(_syncStepLabels[i]);
            }
            _pnlSyncTimeline.Controls.Add(timelineFlow);

            // الإحصائيات
            var statsPanel = new Panel { Height = 54, Dock = DockStyle.Top, BackColor = LightUiTheme.SurfaceAlt, Padding = new Padding(12, 10, 12, 8) };
            var sf = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.LeftToRight, WrapContents = true, BackColor = LightUiTheme.SurfaceAlt };
            _lblQueueCount  = MakeMeta("في الطابور:",   "0");
            _lblTotalSent   = MakeMeta("إجمالي مُرسل:", "0 KB");
            _lblSuccessRate = MakeMeta("معدل النجاح:",  "100%");
            _lblSyncStats   = new Label { Text = "", ForeColor = LightUiTheme.Muted, AutoSize = true };
            sf.Controls.AddRange(new Control[] { _lblQueueCount, _lblTotalSent, _lblSuccessRate, _lblSyncStats });
            statsPanel.Controls.Add(sf);

            // أزرار التحكم
            _pnlSyncControls = new Panel { Height = 56, Dock = DockStyle.Top, BackColor = LightUiTheme.Surface, Padding = new Padding(12, 8, 12, 8) };
            var ctrlFlow = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.LeftToRight, WrapContents = true, BackColor = LightUiTheme.Surface };
            _btnForceSend   = MakeButton("إرسال جبري",  Color.FromArgb(17, 94, 89),  OnForceSend, 140);
            _btnClearFailed = MakeButton("حذف الفاشلة", LightUiTheme.Danger,         OnClearFailed, 140);
            _btnPauseSync   = MakeButton("إيقاف مؤقت",  LightUiTheme.Warning,        OnPauseSync, 130);
            _btnResumeSync  = MakeButton("استئناف",      LightUiTheme.Success,        OnResumeSync, 110);
            ctrlFlow.Controls.AddRange(new Control[] { _btnForceSend, _btnClearFailed, _btnPauseSync, _btnResumeSync });
            _pnlSyncControls.Controls.Add(ctrlFlow);

            // جدول الطابور
            _dgvSyncQueue = CreateDataGrid();
            _dgvSyncQueue.Columns.AddRange(new DataGridViewColumn[]
            {
                new DataGridViewTextBoxColumn { HeaderText = "#",         Width = 40  },
                new DataGridViewTextBoxColumn { HeaderText = "اسم الملف",  Width = 180 },
                new DataGridViewTextBoxColumn { HeaderText = "الحجم",     Width = 90  },
                new DataGridViewTextBoxColumn { HeaderText = "الحالة",    Width = 110 },
                new DataGridViewTextBoxColumn { HeaderText = "التقدم",    Width = 90  },
                new DataGridViewTextBoxColumn { HeaderText = "المحاولات", Width = 80  },
                new DataGridViewTextBoxColumn { HeaderText = "Checksum",  Width = 130 },
                new DataGridViewTextBoxColumn { HeaderText = "وقت الإضافة", Width = 130, AutoSizeMode = DataGridViewAutoSizeColumnMode.Fill }
            });

            _tabSync.Controls.AddRange(new Control[] { _dgvSyncQueue, _pnlSyncControls, statsPanel, _pnlSyncTimeline, _pnlSyncProgress });
        }

        // ═══════════════════════════════════════════
        // TAB 3 — الجورنال
        // ═══════════════════════════════════════════

        private void BuildTabJournal()
        {
            // شريط الفلاتر
            _pnlJournalFilter = new Panel { Height = 130, Dock = DockStyle.Top, BackColor = LightUiTheme.SurfaceAlt, Padding = new Padding(10, 8, 10, 8) };

            // صف 1: أزرار الفلاتر
            var filterNames = new[] { "Approved", "Power Up", "Error E3", "Cash Error", "M-18", "M-02/03/05", "M-10/11", "Capture", "Declined", "الكل" };
            var filterEnums = new[] { JournalSearchFilter.ApprovedTransactions, JournalSearchFilter.PowerUpReset, JournalSearchFilter.ErrorE3, JournalSearchFilter.TotalCashError, JournalSearchFilter.M18, JournalSearchFilter.M02_M03_M05, JournalSearchFilter.M10_M11, JournalSearchFilter.CardCapture, JournalSearchFilter.Declined, JournalSearchFilter.All };
            var filterColors = new[] { LightUiTheme.Success, Color.FromArgb(150, 90, 0), LightUiTheme.Danger, Color.FromArgb(150, 80, 20), Color.FromArgb(126, 58, 140), Color.FromArgb(100, 72, 160), Color.FromArgb(70, 82, 160), Color.FromArgb(140, 56, 100), Color.FromArgb(170, 50, 60), LightUiTheme.Primary };

            _filterBtns = new Button[filterNames.Length];
            var filterRow = new FlowLayoutPanel { Height = 78, Dock = DockStyle.Top, FlowDirection = FlowDirection.LeftToRight, WrapContents = true, BackColor = LightUiTheme.SurfaceAlt };
            for (int i = 0; i < filterNames.Length; i++)
            {
                var idx = i;
                var btn = new Button { Text = filterNames[i], Width = 118, Height = 32, BackColor = filterColors[i], ForeColor = Color.White, FlatStyle = FlatStyle.Flat, Font = new Font("Segoe UI", 8.3f), Margin = new Padding(4, 3, 4, 3), Cursor = Cursors.Hand, AutoEllipsis = true };
                LightUiTheme.StyleButton(btn, filterColors[i]);
                btn.Click += (s, e) => ApplyJournalFilter(filterEnums[idx]);
                filterRow.Controls.Add(btn);
                _filterBtns[i] = btn;
            }

            // صف 2: بحث + تحكم
            var searchRow = new FlowLayoutPanel { Height = 42, Dock = DockStyle.Bottom, FlowDirection = FlowDirection.LeftToRight, WrapContents = true, BackColor = LightUiTheme.SurfaceAlt, Padding = new Padding(0, 4, 0, 0) };
            _cmbJournalFile   = new ComboBox { Width = 220, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text, FlatStyle = FlatStyle.System };
            _txtJournalSearch = new TextBox { Width = 220, BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text, Text = "بحث في الجورنال...", BorderStyle = BorderStyle.FixedSingle };
            _txtJournalSearch.TextChanged += (s, e) => ApplyJournalFreeSearch();
            _btnLoadJournal   = MakeButton("تحميل", LightUiTheme.Primary, OnLoadJournal, 100);
            _btnExportJournal = MakeButton("تصدير", LightUiTheme.Success, OnExportJournal, 100);
            _lblJournalResultCount = new Label { Text = "0 سطر", ForeColor = LightUiTheme.Muted, AutoSize = true, Padding = new Padding(6, 8, 0, 0) };
            searchRow.Controls.AddRange(new Control[] { _cmbJournalFile, _btnLoadJournal, _txtJournalSearch, _btnExportJournal, _lblJournalResultCount });

            _pnlJournalFilter.Controls.AddRange(new Control[] { filterRow, searchRow });

            // إحصائيات الجورنال
            _lblJournalStats = new Label { Dock = DockStyle.Top, Height = 30, BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Muted, Font = new Font("Segoe UI",8.5f), TextAlign = ContentAlignment.MiddleCenter };

            // منطقة النص
            _rtbJournal = new RichTextBox
            {
                Dock = DockStyle.Fill,
                BackColor = LightUiTheme.Surface,
                ForeColor = LightUiTheme.Text,
                Font      = new Font("Segoe UI", 9.5f),
                ReadOnly  = true,
                BorderStyle = BorderStyle.FixedSingle,
                ScrollBars  = RichTextBoxScrollBars.Both,
                WordWrap    = false,
                RightToLeft = RightToLeft.No
            };

            _tabJournal.Controls.AddRange(new Control[] { _rtbJournal, _lblJournalStats, _pnlJournalFilter });
            LoadJournalFiles();
        }

