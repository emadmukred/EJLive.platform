                BackColor = LightUiTheme.Window,
                ForeColor = LightUiTheme.Text,
                Padding = new Padding(10)
            };

            var table = new TableLayoutPanel
            {
                Dock = DockStyle.Fill,
                ColumnCount = 4,
                RowCount = 6,
                BackColor = LightUiTheme.Window
            };
            table.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 45));
            table.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 88));
            table.ColumnStyles.Add(new ColumnStyle(SizeType.Absolute, 88));
            table.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 55));
            table.RowStyles.Add(new RowStyle(SizeType.Absolute, 34));
            for (int row = 1; row < 6; row++)
                table.RowStyles.Add(new RowStyle(SizeType.Absolute, 42));

            AddServiceHeader(table);
            AddServiceRow(table, 1, "conn", "Controller", () => BeginConnect(), () => DisconnectNow(), () => _networkManager?.IsConnected == true, "Connected", "Stopped");
            AddServiceRow(table, 2, "watcher", "File Watcher", StartFileWatcherService, StopFileWatcherService, () => _fileWatcher != null, "Running", "Stopped");
            AddServiceRow(table, 3, "sender", "File Sender", StartSocketFilesService, StopSocketFilesService, () => _journalProcessor?.IsRunning == true, "Running", "Stopped");
            AddServiceRow(table, 4, "ghost", "Ghost Access", StartGhostService, StopGhostService, () => _ghostServiceRunning, "Enabled", "Disabled");
            AddServiceRow(table, 5, "remote", "Windows Remote", StartWindowsRemoteAccessService, StopWindowsRemoteAccessService, WindowsRemoteAccessService.IsRemoteDesktopEnabled, "Enabled", "Disabled");

            servicesGroup.Controls.Add(table);

            var windowsGroup = new GroupBox
            {
                Text = "تشخيص Windows والتشغيل الذاتي",
                Dock = DockStyle.Top,
                Height = 176,
                BackColor = LightUiTheme.Window,
                ForeColor = LightUiTheme.Text,
                Padding = new Padding(10)
            };
            _lblWindowsReadiness = new Label
            {
                Text = "اضغط تشخيص لقراءة جاهزية Windows، التشغيل الذاتي، RDP، والمسارات.",
                Dock = DockStyle.Top,
