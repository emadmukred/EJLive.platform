            _tabSettings.Controls.Add(scroll);
        }

        private void BuildTabSettingsModern()
        {
            var scroll = new Panel
            {
                Dock = DockStyle.Fill,
                AutoScroll = true,
                Padding = new Padding(16, 12, 16, 12),
                BackColor = LightUiTheme.Window
            };

            _txtServerIP = MakeInput("192.168.1.100", 170);
            _txtServerPort = MakeInput("5656", 90);
            _cmbNetworkType = MakeCombo(new[] { "LAN", "ADSL", "GSM", "CDMA" }, 120);
            _txtATMID = MakeInput("ATM001", 130);
            _txtATMName = MakeInput("الاسم", 170);
            _cmbATMType = MakeCombo(AppConstants.GetSupportedATMTypes(), 130);
            _cmbATMType.SelectedIndexChanged += OnATMTypeChanged;
            _txtSourcePath = MakeInput(AppConstants.NCR_JournalPath, 250);
            _txtBackupPath = MakeInput(AppConstants.NCR_BackupPath, 250);
            _btnBrowseSource = MakeButton("...", LightUiTheme.Primary, OnBrowseSource, 44);
            _btnBrowseBackup = MakeButton("...", LightUiTheme.Primary, OnBrowseBackup, 44);
            _chkAutoConnect = MakeCheckbox("اتصال تلقائي عند التشغيل");
            _chkEncrypt = MakeCheckbox("تشفير AES-256", true);
            _chkCompression = MakeCheckbox("ضغط Deflate", true);
            _chkAutoBackup = MakeCheckbox("نسخ احتياطي تلقائي", true);
            _txtCurrentPassword = MakeInput("الحالية", 120); _txtCurrentPassword.UseSystemPasswordChar = true;
            _txtNewPassword = MakeInput("الجديدة", 120); _txtNewPassword.UseSystemPasswordChar = true;
            _txtConfirmPassword = MakeInput("تأكيد", 120); _txtConfirmPassword.UseSystemPasswordChar = true;
            _btnChangePassword = MakeButton("تغيير", Color.FromArgb(80, 62, 140), OnLocalChangePassword, 100);
            _btnSaveSettings = MakeButton("حفظ الإعدادات", LightUiTheme.Success, OnSaveSettings, 190);

            var layout = new TableLayoutPanel
            {
                Dock = DockStyle.Top,
                AutoSize = true,
                AutoSizeMode = AutoSizeMode.GrowAndShrink,
                ColumnCount = 2,
                RowCount = 3,
                BackColor = LightUiTheme.Window
            };
            layout.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 50));
            layout.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 50));
            layout.RowStyles.Add(new RowStyle(SizeType.Absolute, 144));
