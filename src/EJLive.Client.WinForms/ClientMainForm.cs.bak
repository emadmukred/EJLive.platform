        private void OnOpenJournalFolder(object s, EventArgs e) { try { System.Diagnostics.Process.Start("explorer.exe", _config.SourcePath); } catch { } }
        private void OnOpenLogFolder(object s, EventArgs e)     { try { System.Diagnostics.Process.Start("explorer.exe", AppConstants.DefaultLogPath); } catch { } }
        private void OnPing(object s, EventArgs e)
        {
            if (_networkManager?.IsConnected != true) return;
            var ping = CommunicationProtocol.BuildHeartbeat(_config.ATM_ID);
            _networkManager.SendMessage(ping);
            AppendConnLog("Ping مُرسل");
        }

        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            _uiTimer?.Stop();
            _fileWatcher?.Stop();
            _journalProcessor?.Stop();
            _networkManager?.Disconnect();
            AppLogger.Instance.Dispose();
            base.OnFormClosing(e);
        
    


