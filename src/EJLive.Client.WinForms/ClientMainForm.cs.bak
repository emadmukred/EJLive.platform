            _chkCompression  = MakeCheckbox("ضغط Deflate", true);
            _chkAutoBackup   = MakeCheckbox("نسخ احتياطي تلقائي", true);
            optFlow.Controls.AddRange(new Control[] { _chkAutoConnect, _chkEncrypt, _chkCompression, _chkAutoBackup });
            grpOptions.Controls.Add(optFlow);

            // تغيير كلمة السر
            var grpPwd = new GroupBox { Text = "تغيير كلمة المرور", Dock = DockStyle.Top, Height = 100, ForeColor = LightUiTheme.Text, BackColor = LightUiTheme.Window, Padding = new Padding(10), Margin = new Padding(0,10,0,0) };
            var pwdFlow = new FlowLayoutPanel { Dock = DockStyle.Fill, FlowDirection = FlowDirection.LeftToRight, WrapContents = true, BackColor = LightUiTheme.Window };
            _txtCurrentPassword = MakeInput("الحالية",    120); _txtCurrentPassword.UseSystemPasswordChar = true;
            _txtNewPassword     = MakeInput("الجديدة",    120); _txtNewPassword.UseSystemPasswordChar = true;
            _txtConfirmPassword = MakeInput("تأكيد",      120); _txtConfirmPassword.UseSystemPasswordChar = true;
