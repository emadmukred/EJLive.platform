        #region Constructor
        public ClientMainForm()
        {
            _config = new ClientConfig();
            _processId = System.Diagnostics.Process.GetCurrentProcess().Id;
            _lastTelemetrySentAt = DateTime.MinValue;
            InitializeComponent();
            LoadConfig();
            SetupTimers();
            DetermineATMType();
            Log("[System] EJLive Agent v3.4.0 initialized", Color.Cyan);
            Log("[System] PID: " + _processId, Color.Gray);
        }
        #endregion

        #region UI Construction
        private void InitializeComponent()
        {
            SuspendLayout();
            Text = "EJLive Agent v3.4.0";
            Size = new Size(760, 700);
            MinimumSize = new Size(720, 660);
            StartPosition = FormStartPosition.CenterScreen;
            Font = new Font("Segoe UI", 9F);
            Icon = SystemIcons.Application;

            tabMain = new TabControl { Dock = DockStyle.Fill };
            tabClient = new TabPage("Agent");
            tabJournal = new TabPage("Journal Viewer");
            tabLog = new TabPage("Log");
            tabMain.TabPages.AddRange(new[] { tabClient, tabJournal, tabLog });

            BuildClientTab();
            BuildJournalTab();
            BuildLogTab();
            BuildStatusBar();

            Controls.Add(tabMain);
            Controls.Add(statusBar);
            ResumeLayout(false);
        }

        private void BuildClientTab()
        {
            var panel = new Panel { Dock = DockStyle.Fill, AutoScroll = true, Padding = new Padding(5) };
            tabClient.Controls.Add(panel);
            int y = 5;

            grpConnection = new GroupBox { Text = "Agent & Terminal Settings", Location = new Point(5, y), Size = new Size(360, 285) };
            int gy = 20;

            lblName = new Label { Text = "ATM Name:", Location = new Point(10, gy + 3), AutoSize = true };
            txtName = new TextBox { Location = new Point(110, gy), Width = 145 };
            lblNetQuality = new Label { Text = "Link:", Location = new Point(262, gy + 3), AutoSize = true };
            cmbNetQuality = new ComboBox { Location = new Point(298, gy), Width = 52, DropDownStyle = ComboBoxStyle.DropDownList };
            cmbNetQuality.Items.AddRange(new object[] { "LAN", "ADSL", "CDMA", "GSM" });
            cmbNetQuality.SelectedIndex = 0;
            gy += 30;

            lblBranch = new Label { Text = "Branch:", Location = new Point(10, gy + 3), AutoSize = true };
            txtBranch = new TextBox { Location = new Point(110, gy), Width = 240 };
            gy += 30;

            lblRegion = new Label { Text = "Region:", Location = new Point(10, gy + 3), AutoSize = true };
            txtRegion = new TextBox { Location = new Point(110, gy), Width = 240 };
            gy += 30;

            lblNetworkName = new Label { Text = "Network:", Location = new Point(10, gy + 3), AutoSize = true };
            txtNetworkName = new TextBox { Location = new Point(110, gy), Width = 240 };
            gy += 30;

            lblIP = new Label { Text = "Server IP:", Location = new Point(10, gy + 3), AutoSize = true };
            txtIP = new TextBox { Location = new Point(110, gy), Width = 145 };
            btnPing = new Button { Text = "Ping", Location = new Point(270, gy - 1), Size = new Size(80, 26), BackColor = Color.FromArgb(33, 150, 243), ForeColor = Color.White, FlatStyle = FlatStyle.Flat };
            btnPing.Click += BtnPing_Click;
            gy += 30;

            lblPort = new Label { Text = "Port:", Location = new Point(10, gy + 3), AutoSize = true };
            txtPort = new TextBox { Location = new Point(110, gy), Width = 70, Text = "5656" };
            chkAutoReconnect = new CheckBox { Text = "Auto Reconnect", Location = new Point(190, gy + 2), AutoSize = true, Checked = true };
            gy += 30;

            lblMsgSize = new Label { Text = "Msg Size:", Location = new Point(10, gy + 3), AutoSize = true };
            numMsgSize = new NumericUpDown { Location = new Point(110, gy), Width = 60, Minimum = 1, Maximum = 999, Value = 50 };
            new Label { Text = "Lines", Location = new Point(175, gy + 3), AutoSize = true, Parent = grpConnection };
            lblFilePackage = new Label { Text = "File Pkg:", Location = new Point(220, gy + 3), AutoSize = true };
            numFilePackage = new NumericUpDown { Location = new Point(280, gy), Width = 70, Minimum = 1, Maximum = 9999, Value = 512 };
            gy += 30;

            chkSyncTime = new CheckBox { Text = "Sync Time with Server", Location = new Point(10, gy), AutoSize = true };
            lblMessage = new Label { Text = "", Location = new Point(190, gy + 2), AutoSize = true, ForeColor = Color.Green };

            grpConnection.Controls.AddRange(new Control[]
            {
                lblName, txtName, lblNetQuality, cmbNetQuality,
                lblBranch, txtBranch, lblRegion, txtRegion, lblNetworkName, txtNetworkName,
                lblIP, txtIP, btnPing, lblPort, txtPort, chkAutoReconnect,
                lblMsgSize, numMsgSize, lblFilePackage, numFilePackage, chkSyncTime, lblMessage
            });
            panel.Controls.Add(grpConnection);

            grpPaths = new GroupBox { Text = "Paths Configuration", Location = new Point(370, y), Size = new Size(360, 100) };
            lblSourcePath = new Label { Text = "Source Log:", Location = new Point(10, 22), AutoSize = true };
            txtSourcePath = new TextBox { Location = new Point(10, 40), Width = 280, ReadOnly = true };
            btnBrowseSource = new Button { Text = "...", Location = new Point(295, 38), Size = new Size(55, 25) };
            btnBrowseSource.Click += BtnBrowseSource_Click;
            lblBackupPath = new Label { Text = "Backup:", Location = new Point(10, 67), AutoSize = true };
            txtBackupPath = new TextBox { Location = new Point(65, 65), Width = 225, ReadOnly = true };
            btnBrowseBackup = new Button { Text = "...", Location = new Point(295, 63), Size = new Size(55, 25) };
            btnBrowseBackup.Click += BtnBrowseBackup_Click;
            grpPaths.Controls.AddRange(new Control[] { lblSourcePath, txtSourcePath, btnBrowseSource, lblBackupPath, txtBackupPath, btnBrowseBackup });
            panel.Controls.Add(grpPaths);

            grpServiceInfo = new GroupBox { Text = "Agent Service Info", Location = new Point(370, 110), Size = new Size(360, 90) };
            lblPID = new Label { Text = "PID: " + _processId, Location = new Point(10, 22), AutoSize = true };
            lblMemory = new Label { Text = "Memory: 0 MB", Location = new Point(10, 44), AutoSize = true };
            lblUptime = new Label { Text = "Uptime: 00:00:00", Location = new Point(10, 66), AutoSize = true };
            grpServiceInfo.Controls.AddRange(new Control[] { lblPID, lblMemory, lblUptime });
            panel.Controls.Add(grpServiceInfo);

            y = 295;
            grpServices = new GroupBox { Text = "Agent Services Control", Location = new Point(5, y), Size = new Size(725, 210) };
            int sy = 22; int col1 = 10, col2 = 220, col3 = 305, col4 = 460;
            AddServiceRow(grpServices, "Agent Controller:", ref sy, col1, col2, col3, col4, ref btnServiceStart, ref btnServiceStop, ref lblServiceStatus, BtnServiceStart_Click, BtnServiceStop_Click, true);
            AddServiceRow(grpServices, "File Watcher:", ref sy, col1, col2, col3, col4, ref btnFileWatcherStart, ref btnFileWatcherStop, ref lblFileWatcherStatus, BtnFileWatcherStart_Click, BtnFileWatcherStop_Click, false);
            AddServiceRow(grpServices, "Socket Data:", ref sy, col1, col2, col3, col4, ref btnSocketDataStart, ref btnSocketDataStop, ref lblSocketDataStatus, BtnSocketDataStart_Click, BtnSocketDataStop_Click, false);
            AddServiceRow(grpServices, "Socket Files:", ref sy, col1, col2, col3, col4, ref btnSocketFilesStart, ref btnSocketFilesStop, ref lblSocketFilesStatus, BtnSocketFilesStart_Click, BtnSocketFilesStop_Click, false);
            AddServiceRow(grpServices, "Screenshot:", ref sy, col1, col2, col3, col4, ref btnScreenShotStart, ref btnScreenShotStop, ref lblScreenShotStatus, BtnScreenShotStart_Click, BtnScreenShotStop_Click, false);
            AddServiceRow(grpServices, "Ghost Access:", ref sy, col1, col2, col3, col4, ref btnGhostStart, ref btnGhostStop, ref lblGhostStatus, BtnGhostStart_Click, BtnGhostStop_Click, false);
            panel.Controls.Add(grpServices);

            y = 515;
            btnInstall = new Button { Text = "Install Agent", Location = new Point(5, y), Size = new Size(130, 32), BackColor = Color.FromArgb(33, 150, 243), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, Font = new Font("Segoe UI", 10, FontStyle.Bold) };
            btnUninstall = new Button { Text = "Remove Agent", Location = new Point(145, y), Size = new Size(110, 32), BackColor = Color.FromArgb(158, 158, 158), ForeColor = Color.White, FlatStyle = FlatStyle.Flat };
            btnInstall.Click += BtnInstall_Click;
            btnUninstall.Click += BtnUninstall_Click;
            panel.Controls.Add(btnInstall);
            panel.Controls.Add(btnUninstall);
        }

        private void AddServiceRow(GroupBox parent, string label, ref int y, int col1, int col2, int col3, int col4, ref Button btnStart, ref Button btnStop, ref Label lblServiceRowStatus, EventHandler startHandler, EventHandler stopHandler, bool isBold)
        {
            var lbl = new Label { Text = label, Location = new Point(col1, y + 3), AutoSize = true };
            if (isBold) lbl.Font = new Font("Segoe UI", 9, FontStyle.Bold);
            btnStart = new Button { Text = "Start", Location = new Point(col2, y), Size = new Size(75, 25), BackColor = Color.FromArgb(76, 175, 80), ForeColor = Color.White, FlatStyle = FlatStyle.Flat };
            btnStop = new Button { Text = "Stop", Location = new Point(col3, y), Size = new Size(75, 25), BackColor = Color.FromArgb(244, 67, 54), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, Enabled = false };
            lblServiceRowStatus = new Label { Text = "Stopped", Location = new Point(col4, y + 3), AutoSize = true, ForeColor = Color.Gray };
            btnStart.Click += startHandler;
            btnStop.Click += stopHandler;
            parent.Controls.AddRange(new Control[] { lbl, btnStart, btnStop, lblServiceRowStatus });
            y += 30;
        }

        // remaining code unchanged except renamed visible strings below
