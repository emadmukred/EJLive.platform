        private void BuildTabAgentConfig()
        {
            var host = new Panel { Dock = DockStyle.Fill, BackColor = LightUiTheme.Window, Padding = new Padding(14) };

            var header = new Panel { Dock = DockStyle.Top, Height = 88, BackColor = LightUiTheme.SurfaceAlt, Padding = new Padding(12) };
            _lblAgentConfigPath = new Label
            {
                Dock = DockStyle.Top,
                Height = 26,
                ForeColor = LightUiTheme.Text,
                Font = new Font("Segoe UI", 9f, FontStyle.Bold),
                TextAlign = ContentAlignment.MiddleLeft
            };
            _lblAgentConfigStatus = new Label
            {
                Dock = DockStyle.Bottom,
                Height = 22,
                ForeColor = LightUiTheme.Muted,
                TextAlign = ContentAlignment.MiddleLeft
            };

            var actions = new FlowLayoutPanel
            {
                Dock = DockStyle.Fill,
                FlowDirection = FlowDirection.LeftToRight,
                WrapContents = true,
                BackColor = LightUiTheme.SurfaceAlt
            };
            _btnLoadAgentConfig = MakeButton("تحميل XML", LightUiTheme.Primary, OnLoadAgentConfig, 120);
            _btnApplyAgentConfig = MakeButton("تطبيق على الفورم", Color.FromArgb(17, 94, 89), OnApplyAgentConfig, 150);
            _btnSaveAgentConfig = MakeButton("حفظ AgentConf", LightUiTheme.Success, OnSaveAgentConfig, 150);
            _btnOpenAgentConfigFolder = MakeButton("فتح المجلد", LightUiTheme.Warning, OnOpenAgentConfigFolder, 120);
            actions.Controls.AddRange(new Control[] { _btnLoadAgentConfig, _btnApplyAgentConfig, _btnSaveAgentConfig, _btnOpenAgentConfigFolder });

            header.Controls.Add(actions);
            header.Controls.Add(_lblAgentConfigPath);
            header.Controls.Add(_lblAgentConfigStatus);

            _dgvAgentConfig = CreateDataGrid();
            _dgvAgentConfig.ReadOnly = false;
            _dgvAgentConfig.AllowUserToAddRows = true;
            _dgvAgentConfig.AllowUserToDeleteRows = true;
            _dgvAgentConfig.SelectionMode = DataGridViewSelectionMode.CellSelect;
            _dgvAgentConfig.Columns.AddRange(new DataGridViewColumn[]
            {
                new DataGridViewTextBoxColumn { HeaderText = "Key", Width = 190 },
                new DataGridViewTextBoxColumn { HeaderText = "Value", Width = 360 },
                new DataGridViewTextBoxColumn { HeaderText = "الاستخدام التشغيلي", AutoSizeMode = DataGridViewAutoSizeColumnMode.Fill, ReadOnly = true }
            });

            var hint = new Label
            {
                Dock = DockStyle.Bottom,
                Height = 42,
                BackColor = LightUiTheme.SurfaceAlt,
                ForeColor = LightUiTheme.Muted,
                TextAlign = ContentAlignment.MiddleLeft,
                Padding = new Padding(10, 0, 10, 0),
                Text = "هذا التبويب يجعل إعدادات AgentConf.xml مصدر تشغيل واضحًا: Terminal ID، السيرفر، المسارات، Durable Sync، ACK، Dedup."
            };

            host.Controls.Add(_dgvAgentConfig);
            host.Controls.Add(hint);
            host.Controls.Add(header);
            _tabAgentConfig.Controls.Add(host);
            PopulateAgentConfigGrid();
        }

        // ==========================================
        // عمليات الاتصال
        // ==========================================

        private void BeginConnect()
        {
            if (_networkManager != null && _networkManager.IsConnected) return;
            SaveSettingsFromUI();
            PersistAgentConfigurationFromCurrentSettings();
            EnsureClientRuntimeFolders();

            SetConnecting();
            var thread = new Thread(() =>
            {
                InitNetworkManager();
                var ok = _networkManager.Connect();
                BeginInvoke(new Action(() => OnConnectionResult(ok)));
            }) { IsBackground = true };
            thread.Start();
        }

        private void InitNetworkManager()
        {
            EnsureClientRuntimeFolders();
            var outboxPath = Path.Combine(AppConstants.DefaultClientOutboxPath, $"{_config.ATM_ID}_outbox.json");
            _outbox = new JournalOutbox(outboxPath);
            _outbox.OnQueueChanged += (s, count) => BeginInvoke(new Action(() => _lblQueueCount.Text = $"الطابور: {count} ملف"));
            _outbox.OnItemCompleted += (s, item) => RecordClientUploadState(item, UploadHealthState.Acked, null);
            _outbox.OnItemFailed += (s, item) => RecordClientUploadState(item, UploadHealthState.Failed, item.FailReason);
            _networkManager = new NetworkManager(_config.ServerIP, _config.ServerPort,
                _config.ATM_ID, _config.ATM_Type, _config.NetworkType);

            _networkManager.OnConnectionChanged  += (s, ok) => BeginInvoke(new Action(() => OnConnectionChanged(ok)));
            _networkManager.OnSessionEstablished += (s, sid) => BeginInvoke(new Action(() => OnSessionEstablished(sid)));
            _networkManager.OnMessageReceived    += (s, msg) => HandleIncomingMessage(msg);
            _networkManager.OnLog += (s, msg) => AppendConnLog(msg);

            _remoteHandler = new RemoteCommandHandler(_config.ATM_ID, _networkManager, () => _journalProcessor?.ForceSendNow());
            _remoteHandler.OnCommandReceived += (s, cmd) => BeginInvoke(new Action(() => ShowPendingCommand(cmd)));
            _remoteHandler.OnCommandExecuted += (s, cmd) => BeginInvoke(new Action(() => UpdateExecutedCommand(cmd)));
            _remoteHandler.OnGhostFrameSent  += (s, jpg) => BeginInvoke(new Action(() => ShowLocalGhostFrame(jpg)));

            // بدء FileWatcher
            _fileWatcher = new FileWatcherEngine(_config.ATM_ID, _config.ATM_Type, _config.SourcePath, _config.BackupPath, _outbox);
            _fileWatcher.OnNewData += (s, ev) => AppendConnLog($"بيانات جديدة: {ev.FileName} [{ev.BytesRead / 1024.0:F1} KB]");
            _fileWatcher.Start();
        }

        private void OnConnectionResult(bool ok)
        {
            if (ok)
            {
                OnConnectionChanged(true);
                _fileWatcher?.Start();
                StartSyncLoop();
            }
            else
            {
                SetDisconnected();
                AppendConnLog("فشل الاتصال - تحقق من الإعدادات وإمكانية الوصول للسيرفر");
            }
        }

        private void OnConnectionChanged(bool connected)
        {
            if (InvokeRequired) { Invoke(new Action(() => OnConnectionChanged(connected))); return; }
            if (connected)
            {
                _lblConnIndicator.ForeColor = LightUiTheme.Success;
                _lblConnText.Text           = "متصل";
                _lblConnText.ForeColor      = LightUiTheme.Success;
                _lblStatus.Text             = $"● متصل - {_config.ServerIP}:{_config.ServerPort}";
                _lblStatus.ForeColor        = LightUiTheme.Success;
                SetButtonVisual(_btnConnect, LightUiTheme.Success, false);
                SetButtonVisual(_btnDisconnect, LightUiTheme.Danger, true);
                _pbConnProgress.MarqueeAnimationSpeed = 0;
                _lblConnProgress.Text       = "";
                _atmInfo.ConnectionStatus   = ConnectionStatus.Connected;
                _atmInfo.ConnectedAtUtc     = DateTime.UtcNow;
                AppendConnLog($"اتصال ناجح - {_config.ServerIP}:{_config.ServerPort}");
                UpdateServiceStatuses();
                RefreshLocalStateReading(false);
            }
            else
            {
                SetDisconnected();
            }
        }

        private void OnSessionEstablished(string sessionId)
        {
            _atmInfo.SessionId = sessionId;
            _lblSessionId.Text = $"Session: {sessionId}";
        }

        private void HandleIncomingMessage(EJMessage msg)
        {
            if (msg == null) return;
            if (CommunicationProtocol.IsCommand(msg))
                _remoteHandler?.HandleCommand(msg);
        }

        private void SetConnecting()
        {
            _lblConnIndicator.ForeColor = LightUiTheme.Warning;
            _lblConnText.Text           = "يتصل...";
            _lblConnText.ForeColor      = LightUiTheme.Warning;
            _pbConnProgress.MarqueeAnimationSpeed = 40;
            _lblConnProgress.Text       = $"جاري الاتصال بـ {_config.ServerIP}:{_config.ServerPort}...";
            SetButtonVisual(_btnConnect, LightUiTheme.Success, false);
            SetButtonVisual(_btnDisconnect, LightUiTheme.Danger, false);
        }

        private void SetDisconnected()
        {
            if (InvokeRequired) { Invoke(new Action(SetDisconnected)); return; }
            _lblConnIndicator.ForeColor = LightUiTheme.Muted;
            _lblConnText.Text           = "غير متصل";
            _lblConnText.ForeColor      = LightUiTheme.Danger;
            _lblStatus.Text             = "● غير متصل";
            _lblStatus.ForeColor        = LightUiTheme.Danger;
            SetButtonVisual(_btnConnect, LightUiTheme.Success, true);
            SetButtonVisual(_btnDisconnect, LightUiTheme.Danger, false);
            _pbConnProgress.MarqueeAnimationSpeed = 0;
            _lblConnProgress.Text       = "";
            _atmInfo.ConnectionStatus   = ConnectionStatus.Disconnected;
            UpdateServiceStatuses();
            RefreshLocalStateReading(false);
        }

        private void DisconnectNow()
        {
            _fileWatcher?.Stop();
            _fileWatcher = null;
            _networkManager?.Disconnect();
            SetDisconnected();
            UpdateServiceStatuses();
            RefreshLocalStateReading(false);
        }

        private void StartFileWatcherService()
        {
            SaveSettingsFromUI();
            EnsureClientRuntimeFolders();
            if (_outbox == null)
                _outbox = new JournalOutbox(Path.Combine(AppConstants.DefaultClientOutboxPath, $"{_config.ATM_ID}_outbox.json"));
            if (_fileWatcher == null)
            {
                _fileWatcher = new FileWatcherEngine(_config.ATM_ID, _config.ATM_Type, _config.SourcePath, _config.BackupPath, _outbox);
                _fileWatcher.OnNewData += (s, ev) => AppendConnLog($"بيانات جديدة: {ev.FileName} [{ev.BytesRead / 1024.0:F1} KB]");
            }
            _fileWatcher.Start();
            AppendConnLog("File Watcher started.");
            RefreshLocalStateReading(false);
        }

        private void StopFileWatcherService()
        {
            _fileWatcher?.Stop();
            _fileWatcher = null;
            AppendConnLog("File Watcher stopped.");
            RefreshLocalStateReading(false);
        }

        private void StartSocketFilesService()
        {
            if (_networkManager?.IsConnected != true)
            {
                AppendConnLog("Socket Files requires an active server connection.", AppLogger.Level.Warning);
                return;
            }
            if (_journalProcessor?.IsRunning != true)
                StartSyncLoop();
            AppendConnLog("Socket Files sender started.");
            RefreshLocalStateReading(false);
        }

        private void StopSocketFilesService()
        {
            _journalProcessor?.Stop();
            _journalProcessor = null;
            AppendConnLog("Socket Files sender stopped.");
            RefreshLocalStateReading(false);
        }

        private void StartScreenshotService()
        {
            CaptureAndDisplayScreenshot();
        }

        private void StopScreenshotService()
        {
            OnStopScreen();
        }

        private void StartGhostService()
        {
            _ghostServiceRunning = true;
            AppendConnLog("Ghost Access service ready for remote screen commands.");
        }

        private void StopGhostService()
        {
            _ghostServiceRunning = false;
            AppendConnLog("Ghost Access service stopped.");
        }

        private void StartWindowsRemoteAccessService()
        {
            var result = WindowsRemoteAccessService.EnableRemoteDesktop();
            AppendConnLog(result.Message, result.Success ? AppLogger.Level.Info : AppLogger.Level.Warning);
            if (!result.Success && result.RequiresAdministrator)
                MessageBox.Show(result.Message, "Windows Remote Access", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            RefreshLocalStateReading(true);
        }

        private void StopWindowsRemoteAccessService()
        {
            var result = WindowsRemoteAccessService.DisableRemoteDesktop();
            AppendConnLog(result.Message, result.Success ? AppLogger.Level.Info : AppLogger.Level.Warning);
            if (!result.Success && result.RequiresAdministrator)
                MessageBox.Show(result.Message, "Windows Remote Access", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            RefreshLocalStateReading(true);
        }

        private void RunWindowsDiagnostics()
        {
            var isAdmin = IsRunningAsAdministrator();
            var autoStart = WindowsStartupService.IsClientAutostartRegistered();
            var rdpEnabled = WindowsRemoteAccessService.IsRemoteDesktopEnabled();
            var sourceOk = Directory.Exists(_config.SourcePath);
            var backupOk = Directory.Exists(_config.BackupPath);
            var connected = _networkManager?.IsConnected == true;
            var syncRunning = _journalProcessor?.IsRunning == true;

            var checks = new List<Tuple<string, bool, string>>
            {
                Tuple.Create("Administrator", isAdmin, isAdmin ? "صلاحيات مدير متاحة" : "عمليات RDP/Startup تحتاج تشغيل كمسؤول"),
                Tuple.Create("AutoStart", autoStart, autoStart ? "مسجل في مهام Windows" : "غير مسجل للتشغيل عند بدء النظام"),
                Tuple.Create("RemoteDesktop", rdpEnabled, rdpEnabled ? "RDP مفعل" : "RDP غير مفعل"),
                Tuple.Create("SourcePath", sourceOk, sourceOk ? _config.SourcePath : "مسار المصدر غير موجود: " + _config.SourcePath),
                Tuple.Create("BackupPath", backupOk, backupOk ? _config.BackupPath : "مسار النسخ غير موجود: " + _config.BackupPath),
                Tuple.Create("ServerConnection", connected, connected ? "متصل بالخادم" : "غير متصل بالخادم"),
                Tuple.Create("JournalProcessor", syncRunning, syncRunning ? "المزامنة تعمل" : "المزامنة متوقفة")
            };

            var ok = 0;
            AppendWindowsOps("DIAG", "بدء تشخيص Windows والعميل");
            foreach (var check in checks)
            {
                if (check.Item2) ok++;
                AppendWindowsOps(check.Item2 ? "OK" : "WARN", $"{check.Item1}: {check.Item3}");
            }

            _cachedAutoStartRegistered = autoStart;
            _cachedRemoteDesktopEnabled = rdpEnabled;
            _hasWindowsStateCache = true;
            _lastWindowsStateRefreshUtc = DateTime.UtcNow;

            var percent = checks.Count > 0 ? (double)ok / checks.Count * 100.0 : 0.0;
            _lblWindowsReadiness.Text = $"جاهزية Windows/Client: {percent:F0}% ({ok}/{checks.Count})";
            _lblWindowsReadiness.ForeColor = percent >= 80 ? LightUiTheme.Success : percent >= 55 ? LightUiTheme.Warning : LightUiTheme.Danger;
            AppendConnLog(_lblWindowsReadiness.Text, percent >= 55 ? AppLogger.Level.Info : AppLogger.Level.Warning);
            RefreshLocalStateReading(false);
        }

        private void RegisterWindowsStartup()
        {
            var result = WindowsStartupService.RegisterClientAutostart(Application.ExecutablePath);
            AppendWindowsOps(result.Success ? "OK" : "WARN", result.Message);
            AppendConnLog(result.Message, result.Success ? AppLogger.Level.Info : AppLogger.Level.Warning);
            RunWindowsDiagnostics();
            RefreshLocalStateReading(true);
        }

        private void UnregisterWindowsStartup()
        {
            var result = WindowsStartupService.UnregisterClientAutostart();
            AppendWindowsOps(result.Success ? "OK" : "WARN", result.Message);
            AppendConnLog(result.Message, result.Success ? AppLogger.Level.Info : AppLogger.Level.Warning);
            RunWindowsDiagnostics();
            RefreshLocalStateReading(true);
        }

        private void RefreshLocalStateReading(bool includeWindowsChecks)
        {
            if (_dgvLocalState == null || _lblLocalStateSummary == null || IsDisposed) return;
            if (_dgvLocalState.InvokeRequired)
            {
                _dgvLocalState.Invoke(new Action(() => RefreshLocalStateReading(includeWindowsChecks)));
                return;
            }

            if (includeWindowsChecks || !_hasWindowsStateCache ||
                (DateTime.UtcNow - _lastWindowsStateRefreshUtc).TotalSeconds > 45)
            {
                _cachedAutoStartRegistered = WindowsStartupService.IsClientAutostartRegistered();
                _cachedRemoteDesktopEnabled = WindowsRemoteAccessService.IsRemoteDesktopEnabled();
                _hasWindowsStateCache = true;
                _lastWindowsStateRefreshUtc = DateTime.UtcNow;
            }

            if (includeWindowsChecks || (DateTime.UtcNow - _lastMonthlyArchiveRefreshUtc).TotalSeconds > 60)
                RefreshMonthlyArchiveCache();

            _dgvLocalState.Rows.Clear();
            var healthy = 0;
            var warning = 0;
            var critical = 0;

            var connected = _networkManager?.IsConnected == true;
            AddLocalStateRow("الاتصال", connected ? "سليم" : "حرج",
                connected ? $"متصل بالخادم {_config.ServerIP}:{_config.ServerPort}" : $"لا توجد جلسة مع {_config.ServerIP}:{_config.ServerPort}",
                connected ? "مراقبة الجلسة والنبض" : "اضغط اتصال أو تحقق من IP والمنفذ والخادم",
                ref healthy, ref warning, ref critical);

            var watcherRunning = _fileWatcher?.IsRunning == true;
            AddLocalStateRow("مراقبة الجورنال", watcherRunning ? "سليم" : "تحذير",
                watcherRunning ? $"نشطة | ملفات: {_fileWatcher.TotalFilesDetected} | قراءة: {_fileWatcher.TotalBytesRead / 1024.0:F1} KB" : "File Watcher غير نشط",
                watcherRunning ? "استمرار مراقبة المصدر" : "ابدأ File Watcher من الخدمات أو اتصل بالخادم",
                ref healthy, ref warning, ref critical);

            var syncRunning = _journalProcessor?.IsRunning == true;
            var syncPaused = _journalProcessor?.IsPaused == true;
            var syncState = syncRunning && !syncPaused ? "سليم" : syncPaused ? "تحذير" : "تحذير";
            AddLocalStateRow("المزامنة", syncState,
                syncRunning ? (syncPaused ? "متوقفة مؤقتاً بقرار المشغل" : $"تعمل | مرسل: {_journalProcessor.TotalSent} | فشل: {_journalProcessor.TotalFailed}") : "معالج المزامنة متوقف",
                syncRunning && !syncPaused ? "المعالجة مستمرة" : "استئناف المزامنة أو بدء Socket Files",
                ref healthy, ref warning, ref critical);

            var sourceOk = Directory.Exists(_config.SourcePath);
            AddLocalStateRow("مسار المصدر", sourceOk ? "سليم" : "حرج",
                sourceOk ? _config.SourcePath : $"غير موجود: {_config.SourcePath}",
                sourceOk ? "جاهز لقراءة الجورنال" : "صحح المسار من الإعدادات أو أنشئ المجلد",
                ref healthy, ref warning, ref critical);

            var backupOk = Directory.Exists(_config.BackupPath);
            AddLocalStateRow("مسار النسخ", backupOk ? "سليم" : "حرج",
                backupOk ? _config.BackupPath : $"غير موجود: {_config.BackupPath}",
                backupOk ? "جاهز للأرشفة واللقطات" : "أنشئ مجلد النسخ أو عدله من الإعدادات",
                ref healthy, ref warning, ref critical);

            var monthlyArchivePath = Path.Combine(_config.BackupPath ?? string.Empty, "MonthlyArchive");
            var archiveState = !backupOk ? "حرج" : Directory.Exists(monthlyArchivePath) ? "سليم" : "تحذير";
            AddLocalStateRow("الأرشفة الشهرية", archiveState,
                Directory.Exists(monthlyArchivePath)
                    ? $"{_cachedMonthlyArchiveFiles:N0} ملف | {FormatHumanBytes(_cachedMonthlyArchiveBytes)} | {monthlyArchivePath}"
                    : $"لم يتم تجهيز المجلد: {monthlyArchivePath}",
                Directory.Exists(monthlyArchivePath)
                    ? "جاهزة لتجميع ملفات الشهر وترحيلها"
                    : "نفذ تهيئة المجلدات أو احفظ الإعدادات لإعادة إنشائه",
                ref healthy, ref warning, ref critical);

            var pending = _outbox?.PendingCount ?? 0;
            var inFlight = _outbox?.InFlightCount ?? 0;
            var failed = _outbox?.TotalFailed ?? 0;
            var outboxState = failed > 0 ? "تحذير" : pending > 20 ? "تحذير" : "سليم";
            AddLocalStateRow("طابور الإرسال", outboxState,
                $"منتظر: {pending} | قيد الإرسال: {inFlight} | فشل: {failed}",
                pending > 0 ? "إرسال جبري أو انتظار عودة الاتصال" : "لا توجد عناصر عالقة",
                ref healthy, ref warning, ref critical);

            var remoteCommandState = GetRemoteCommandHealth();
            AddLocalStateRow("آخر أمر بعيد", remoteCommandState,
                _lastRemoteCommandAtLocal == DateTime.MinValue
                    ? "لم تصل أوامر من الخادم بعد"
                    : $"{_lastRemoteCommandType} | {_lastRemoteCommandStatus} | {_lastRemoteCommandAtLocal:HH:mm:ss} | {_lastRemoteCommandResult}",
                remoteCommandState == "سليم"
                    ? "التنفيذ موثق في تبويب التحكم"
                    : remoteCommandState == "حرج" ? "راجع نتيجة الأمر وسجل التحكم" : "بانتظار أمر أو نتيجة تنفيذ",
                ref healthy, ref warning, ref critical);

            AddLocalStateRow("تشغيل Windows", _cachedAutoStartRegistered ? "سليم" : "تحذير",
                _cachedAutoStartRegistered ? "مسجل للتشغيل التلقائي" : "غير مسجل في مهام Windows",
                _cachedAutoStartRegistered ? "لا إجراء مطلوب" : "سجل التشغيل التلقائي من تبويب الخدمات كمسؤول",
                ref healthy, ref warning, ref critical);

            AddLocalStateRow("التحكم المحلي", _cachedRemoteDesktopEnabled ? "سليم" : "تحذير",
                _cachedRemoteDesktopEnabled ? "Remote Desktop مفعل" : "Remote Desktop غير مفعل",
                _cachedRemoteDesktopEnabled ? "جاهز لدعم التحكم المحلي/البعيد" : "فعّل Windows Remote من الخدمات عند الحاجة",
                ref healthy, ref warning, ref critical);

            var summary = $"قراءة الحالات المحلية: {healthy} سليم | {warning} مراقبة | {critical} حرج";
            _lblLocalStateSummary.Text = summary;
            _lblLocalStateSummary.ForeColor = critical > 0 ? LightUiTheme.Danger : warning > 0 ? LightUiTheme.Warning : LightUiTheme.Success;

            var signature = $"{healthy}:{warning}:{critical}:{connected}:{watcherRunning}:{syncRunning}:{syncPaused}:{pending}:{failed}:{_cachedMonthlyArchiveFiles}:{_cachedMonthlyArchiveBytes}:{_lastRemoteCommandType}:{_lastRemoteCommandStatus}";
            if (!string.Equals(_lastLocalStateSignature, signature, StringComparison.Ordinal))
            {
                _lastLocalStateSignature = signature;
                if (critical > 0 || warning > 0)
                    AppendConnLog(summary, critical > 0 ? AppLogger.Level.Warning : AppLogger.Level.Info);
            }
        }

        private void AddLocalStateRow(string domain, string state, string reading, string action,
            ref int healthy, ref int warning, ref int critical)
        {
            var rowIndex = _dgvLocalState.Rows.Add(domain, state, reading, action);
            var row = _dgvLocalState.Rows[rowIndex];
            Color color;
            switch (state)
            {
                case "سليم":
                    healthy++;
                    color = LightUiTheme.Success;
                    break;
                case "حرج":
                    critical++;
                    color = LightUiTheme.Danger;
                    break;
                default:
                    warning++;
                    color = LightUiTheme.Warning;
                    break;
            }

            row.Cells[1].Style.ForeColor = color;
            row.Cells[1].Style.Font = new Font("Segoe UI", 8.5f, FontStyle.Bold);
            row.DefaultCellStyle.SelectionBackColor = color;
            row.DefaultCellStyle.SelectionForeColor = Color.White;
        }

        private void RefreshMonthlyArchiveCache()
        {
            _cachedMonthlyArchiveFiles = 0;
            _cachedMonthlyArchiveBytes = 0;
            _lastMonthlyArchiveRefreshUtc = DateTime.UtcNow;

            try
            {
                var folder = Path.Combine(_config.BackupPath ?? string.Empty, "MonthlyArchive");
                if (!Directory.Exists(folder)) return;

                foreach (var file in Directory.GetFiles(folder, "*.*", SearchOption.AllDirectories))
                {
                    try
                    {
                        var info = new FileInfo(file);
                        _cachedMonthlyArchiveFiles++;
                        _cachedMonthlyArchiveBytes += info.Length;
                    }
                    catch (IOException) { }
                    catch (UnauthorizedAccessException) { }
                }
            }
            catch (Exception ex)
            {
                AppLogger.Instance.Warning($"Monthly archive scan failed: {ex.Message}", "ClientState");
            }
        }

        private string GetRemoteCommandHealth()
        {
            if (_lastRemoteCommandAtLocal == DateTime.MinValue) return "تحذير";
            if (string.Equals(_lastRemoteCommandStatus, "فشل", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(_lastRemoteCommandStatus, "مهلة", StringComparison.OrdinalIgnoreCase))
                return "حرج";
            if (string.Equals(_lastRemoteCommandStatus, "نُفذ", StringComparison.OrdinalIgnoreCase))
                return "سليم";
            return "تحذير";
        }

        private static string FormatHumanBytes(long bytes)
        {
            if (bytes < 1024) return $"{bytes:N0} B";
            var kb = bytes / 1024.0;
            if (kb < 1024) return $"{kb:N1} KB";
            var mb = kb / 1024.0;
            if (mb < 1024) return $"{mb:N1} MB";
            return $"{mb / 1024.0:N1} GB";
        }

        private void AppendWindowsOps(string tag, string message)
        {
            var line = $"[{DateTime.Now:HH:mm:ss}] {tag} | {message}\r\n";
            if (_rtbWindowsOpsLog == null) return;
            if (_rtbWindowsOpsLog.InvokeRequired)
            {
                _rtbWindowsOpsLog.Invoke(new Action(() => AppendWindowsOps(tag, message)));
                return;
            }
            _rtbWindowsOpsLog.AppendText(line);
            _rtbWindowsOpsLog.ScrollToCaret();
        }

        private static bool IsRunningAsAdministrator()
        {
            try
            {
                using (var identity = System.Security.Principal.WindowsIdentity.GetCurrent())
                {
                    return new System.Security.Principal.WindowsPrincipal(identity)
                        .IsInRole(System.Security.Principal.WindowsBuiltInRole.Administrator);
                }
            }
            catch
            {
                return false;
            }
        }

        private string CaptureScreenshotToFile()
        {
            var folder = Path.Combine(_config.BackupPath, "Screenshots");
            Directory.CreateDirectory(folder);
            var filePath = Path.Combine(folder, $"{_config.ATM_ID}_{DateTime.Now:yyyyMMdd_HHmmss}.jpg");
            var bounds = Screen.PrimaryScreen.Bounds;
            using var bmp = new Bitmap(bounds.Width, bounds.Height);
            using (var g = Graphics.FromImage(bmp))
                g.CopyFromScreen(bounds.Location, Point.Empty, bounds.Size);
            bmp.Save(filePath, ImageFormat.Jpeg);
            return filePath;
        }

        private void CaptureAndDisplayScreenshot()
        {
            try
            {
                EnsureClientRuntimeFolders();
                _lastScreenshotPath = CaptureScreenshotToFile();
                var bytes = File.ReadAllBytes(_lastScreenshotPath);
                using (var ms = new MemoryStream(bytes))
                using (var image = Image.FromStream(ms))
                {
                    _pbRemoteScreen?.Image?.Dispose();
                    _pbRemoteScreen.Image = new Bitmap(image);
                }

                if (_networkManager?.IsConnected == true)
                    _networkManager.SendMessage(CommunicationProtocol.BuildGhostFrame(bytes));

                _lblRemoteStatus.Text = $"آخر لقطة: {DateTime.Now:HH:mm:ss}";
                _lblRemoteStatus.ForeColor = LightUiTheme.Success;
                _lblFPS.Text = $"{Math.Max(1, bytes.Length / 1024)} KB";
                AppendConnLog($"Screenshot captured: {_lastScreenshotPath}");
            }
            catch (Exception ex)
            {
                _lblRemoteStatus.Text = "فشل التقاط الشاشة";
                _lblRemoteStatus.ForeColor = LightUiTheme.Danger;
                AppendConnLog($"Screenshot failed: {ex.Message}", AppLogger.Level.Error);
            }
        }

        private void EnsureClientRuntimeFolders()
        {
            _config.ApplyDefaults();
            foreach (var folder in AppConstants.GetClientRuntimeFolders(_config.ATM_Type, _config.SourcePath, _config.BackupPath))
            {
                try
                {
                    if (!string.IsNullOrWhiteSpace(folder))
                        Directory.CreateDirectory(folder);
                }
                catch (Exception ex)
                {
                    AppLogger.Instance.Warning($"Cannot create folder '{folder}': {ex.Message}", "ClientFolders");
                }
            }
        }

        private void UpdateServiceStatuses()
        {
            if (_serviceRows.Count == 0) return;
            foreach (var row in _serviceRows.Values)
            {
                if (row?.IsRunning == null || row.StatusLabel == null) continue;
                var running = row.IsRunning();
                row.StatusLabel.Text = running ? $"[ON] {row.RunningText}" : $"[OFF] {row.StoppedText}";
                row.StatusLabel.ForeColor = running ? LightUiTheme.Success : LightUiTheme.Muted;
                SetButtonVisual(row.StartButton, LightUiTheme.Success, !running);
                SetButtonVisual(row.StopButton, LightUiTheme.Danger, running);
            }
        }

        // ==========================================
        // حلقة المزامنة
        // ==========================================

        private void StartSyncLoop()
        {
            if (_journalProcessor?.IsRunning == true) return;
            _journalProcessor = new JournalProcessor(_networkManager, _outbox);
            _journalProcessor.OnSyncProgress += (s, prog) => BeginInvoke(new Action(() => UpdateSyncProgress(prog)));
            _journalProcessor.OnItemCompleted += (s, item) => BeginInvoke(new Action(() => MarkSyncCompleted(item)));
            _journalProcessor.OnItemFailed    += (s, item) => BeginInvoke(new Action(() => MarkSyncFailed(item)));
            _journalProcessor.Start();
            UpdateServiceStatuses();
            RefreshLocalStateReading(false);
        }

        private void UpdateSyncProgress(LiveSyncProgress prog)
        {
            _pbSyncProgress.Value = Math.Max(0, Math.Min(100, prog.Percent));
            _lblSyncPercent.Text  = $"{prog.Percent}%";
            _lblSyncFile.Text     = $"{prog.FileName} [{prog.BytesSentDisplay} / {prog.TotalBytesDisplay}]";
            _lblSyncState.Text    = $"المزامنة: {prog.FileName} {prog.Percent}%";
            _lblSpeed.Text        = $"السرعة: {prog.SpeedKBs:F1} KB/s";
            UpdateSyncTimeline(prog.Percent, false);
        }

        private void MarkSyncCompleted(JournalOutboxItem item)
        {
            RecordClientUploadState(item, UploadHealthState.Acked, null);
            _lblTotalSent.Text = $"مُرسل: {(_networkManager?.TotalBytesSent ?? 0) / 1024.0:F1} KB";
            RefreshSyncQueue();
            UpdateSyncTimeline(100, false);
            AppendConnLog($"مزامنة ناجحة: {item.FileName}");
            RefreshLocalStateReading(false);
        }

        private void MarkSyncFailed(JournalOutboxItem item)
        {
            RecordClientUploadState(item, UploadHealthState.Failed, item?.FailReason);
            RefreshSyncQueue();
            UpdateSyncTimeline(_pbSyncProgress.Value, true);
            AppendConnLog($"فشل مزامنة: {item.FileName} - {item.FailReason}");
            RefreshLocalStateReading(false);
        }

        private void RecordClientUploadState(JournalOutboxItem item, UploadHealthState state, string failureReason)
        {
            if (item == null) return;
            OperationalStateStore.Instance.UpsertUpload(new UploadLogRecord
            {
                UploadId = $"{_config.ATM_ID}|{item.FileName}|{item.Checksum}".ToUpperInvariant(),
                TerminalId = _config.ATM_ID,
                FileName = item.FileName,
                FileKind = "EJ",
                SourcePath = item.LocalPath,
                BytesExpected = item.DataSize,
                BytesReceived = state == UploadHealthState.Acked ? item.DataSize : 0,
                Checksum = item.Checksum,
                AckId = state == UploadHealthState.Acked ? $"CLIENT-ACK-{DateTime.UtcNow:yyyyMMddHHmmss}" : null,
                State = state,
                FailureReason = failureReason,
                CreatedAtUtc = item.EnqueuedAt == default(DateTime) ? DateTime.UtcNow : item.EnqueuedAt,
                UpdatedAtUtc = DateTime.UtcNow
            });
        }

        private void UpdateSyncTimeline(int percent, bool failed)
        {
            if (_syncStepLabels == null || _syncStepLabels.Length == 0) return;
            var activeStep = percent >= 100 ? 4 : percent >= 70 ? 3 : percent >= 40 ? 2 : percent >= 15 ? 1 : 0;
            for (int i = 0; i < _syncStepLabels.Length; i++)
            {
                var label = _syncStepLabels[i];
                if (label == null) continue;
                if (failed && i == activeStep)
                {
                    label.BackColor = LightUiTheme.Danger;
                    label.ForeColor = Color.White;
                }
                else if (i <= activeStep)
                {
                    label.BackColor = i == activeStep ? LightUiTheme.Primary : LightUiTheme.Success;
                    label.ForeColor = Color.White;
                }
                else
                {
                    label.BackColor = LightUiTheme.Surface;
                    label.ForeColor = LightUiTheme.Muted;
                }
            }
        }

        private void RefreshSyncQueue()
        {
            if (_outbox == null) return;
            _dgvSyncQueue.Rows.Clear();
            _lblQueueCount.Text = $"الطابور: {_outbox.PendingCount} ملف";
        }

        private void OnForceSend(object s = null, EventArgs e = null)
        {
            if (_journalProcessor == null)
            {
                AppendConnLog("لا يمكن الإرسال الجبري: خدمة المزامنة غير مفعلة.", AppLogger.Level.Warning);
                return;
            }
            _journalProcessor.ForceSendNow();
            AppendConnLog("تم إطلاق الإرسال الجبري للطابور الحالي");
        }

        private void OnClearFailed(object s = null, EventArgs e = null)
        {
            int removed = 0;
            for (int i = _dgvSyncQueue.Rows.Count - 1; i >= 0; i--)
            {
                var state = _dgvSyncQueue.Rows[i].Cells.Count > 3
                    ? _dgvSyncQueue.Rows[i].Cells[3].Value?.ToString()
                    : null;
                if (!string.IsNullOrWhiteSpace(state) &&
                    state.IndexOf("فشل", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    _dgvSyncQueue.Rows.RemoveAt(i);
                    removed++;
                }
            }

            _lblSyncStats.Text = $"الفاشلة المحذوفة من العرض: {removed} | إجمالي الفشل: {_outbox?.TotalFailed ?? 0}";
            AppendConnLog($"تنظيف عرض الطابور: أزيلت {removed} عناصر فاشلة من الجدول");
        }

        private void OnPauseSync(object s = null, EventArgs e = null)
        {
            _journalProcessor?.Pause();
            _lblSyncState.Text = "المزامنة: متوقفة مؤقتاً";
            AppendConnLog("تم إيقاف المزامنة مؤقتاً بقرار المشغل");
            RefreshLocalStateReading(false);
        }

        private void OnResumeSync(object s = null, EventArgs e = null)
        {
            _journalProcessor?.Resume();
            _lblSyncState.Text = "المزامنة: مستأنفة";
            AppendConnLog("تم استئناف المزامنة");
            RefreshLocalStateReading(false);
        }

        // ==========================================
        // الجورنال
        // ==========================================

        private string _journalRawText = "";

        private void LoadJournalFiles()
        {
            _cmbJournalFile.Items.Clear();
            var path = _config.SourcePath;
            if (!Directory.Exists(path)) return;
            foreach (var f in Directory.GetFiles(path))
                _cmbJournalFile.Items.Add(Path.GetFileName(f));
            if (_cmbJournalFile.Items.Count > 0) _cmbJournalFile.SelectedIndex = 0;
        }

        private void InitializeComponent()
        {
            this.SuspendLayout();
            // 
            // ClientMainForm
            // 
            this.ClientSize = new System.Drawing.Size(762, 401);
            this.ForeColor = System.Drawing.SystemColors.HotTrack;
            this.Name = "ClientMainForm";
            this.ResumeLayout(false);

        }

        private void OnLoadJournal(object s = null, EventArgs e = null)
        {
            var file = _cmbJournalFile.SelectedItem?.ToString();
            if (string.IsNullOrEmpty(file)) return;
            var path = Path.Combine(_config.SourcePath, file);
            if (!File.Exists(path)) return;
            try
            {
                using var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete);
                using var sr = new System.IO.StreamReader(fs, System.Text.Encoding.UTF8, true);
                _journalRawText = sr.ReadToEnd();
                SetJournalText(_journalRawText);
                UpdateJournalStats();
            }
            catch (Exception ex) { AppendConnLog($"خطأ: {ex.Message}"); }
        }

        private void SetJournalText(string text)
        {
            _rtbJournal.Clear();
            _rtbJournal.Text = text;
            _lblJournalResultCount.Text = $"{text.Split('\n').Length:N0} سطر";
        }

        private void ApplyJournalFilter(JournalSearchFilter filter)
        {
            if (string.IsNullOrEmpty(_journalRawText)) return;
            if (filter == JournalSearchFilter.All) { SetJournalText(_journalRawText); return; }
            var lines = _analysisEngine.SearchLines(_journalRawText, filter);
            _rtbJournal.Clear();
            foreach (var line in lines)
            {
                _rtbJournal.SelectionColor = GetLineColor(line);
                _rtbJournal.AppendText(line + "\n");
            }
            _lblJournalResultCount.Text = $"{lines.Count} نتيجة";
        }

        private void ApplyJournalFreeSearch()
        {
            var kw = _txtJournalSearch.Text.Trim();
            if (string.IsNullOrEmpty(kw) || kw == "بحث في الجورنال...") { SetJournalText(_journalRawText); return; }
            var lines = _analysisEngine.SearchFreeText(_journalRawText, kw);
            _rtbJournal.Clear();
            foreach (var line in lines) _rtbJournal.AppendText(line + "\n");
            _lblJournalResultCount.Text = $"{lines.Count} نتيجة";
        }

        private void UpdateJournalStats()
        {
            if (string.IsNullOrEmpty(_journalRawText)) return;
            var filePath = Path.Combine(_config.SourcePath, _cmbJournalFile.SelectedItem?.ToString() ?? "");
            var lines = _journalRawText.Split('\n').Length;
            var sizeKb = File.Exists(filePath) ? new FileInfo(filePath).Length / 1024.0 : 0;
            _lblJournalStats.Text = $"Local preview | Lines: {lines:N0} | Size: {sizeKb:F1} KB | Analytics moved to server dashboard";
        }

        private Color GetLineColor(string line)
        {
            var u = line.ToUpperInvariant();
            if (u.Contains("DISPENSE") || u.Contains("APPROVED")) return Color.FromArgb(20, 120, 60);
            if (u.Contains("DECLINED") || u.Contains("UNABLE"))   return LightUiTheme.Danger;
            if (u.Contains("CAPTURE") || u.Contains("RETAIN"))    return Color.FromArgb(150, 90, 0);
            if (u.Contains("ERROR"))  return LightUiTheme.Danger;
            if (u.Contains("POWER UP") || u.Contains("RESTART"))  return LightUiTheme.Primary;
            return LightUiTheme.Text;
        }

        private void OnExportJournal(object s = null, EventArgs e = null)
        {
            using var dlg = new SaveFileDialog { Filter = "Text Files|*.txt", FileName = $"journal_{_config.ATM_ID}_{DateTime.Now:yyyyMMdd}" };
            if (dlg.ShowDialog() == DialogResult.OK)
                File.WriteAllText(dlg.FileName, _rtbJournal.Text, System.Text.Encoding.UTF8);
        }

        // ==========================================
        // التحكم البعيد
        // ==========================================

        private void ShowPendingCommand(RemoteCommand cmd)
        {
            if (_dgvPendingCmds == null || _rtbRemoteLog == null) return;
            _dgvPendingCmds.Rows.Insert(0, cmd.CommandType, cmd.CommandId, ToArabicCommandStatus(cmd.Status), cmd.SentAtUtc.ToLocalTime().ToString("HH:mm:ss"), "بانتظار التنفيذ");
            _remoteCommandRows[cmd.CommandId] = _dgvPendingCmds.Rows[0];
            _rtbRemoteLog.AppendText($"\r\n[{DateTime.Now:HH:mm:ss}] أمر مُستلم: {cmd.CommandType} [{cmd.CommandId}]");
            _lastRemoteCommandType = cmd.CommandType ?? "—";
            _lastRemoteCommandStatus = ToArabicCommandStatus(cmd.Status);
            _lastRemoteCommandResult = "بانتظار التنفيذ";
            _lastRemoteCommandAtLocal = DateTime.Now;
            AppendConnLog($"أمر وارد: {cmd.CommandType}");
            RefreshLocalStateReading(false);
        }

        private void UpdateExecutedCommand(RemoteCommand cmd)
        {
            if (_dgvPendingCmds == null || cmd == null) return;
            if (!_remoteCommandRows.TryGetValue(cmd.CommandId, out var row) || row.DataGridView == null)
            {
                _dgvPendingCmds.Rows.Insert(0, cmd.CommandType, cmd.CommandId, ToArabicCommandStatus(cmd.Status), DateTime.Now.ToString("HH:mm:ss"), cmd.Result ?? "");
                row = _dgvPendingCmds.Rows[0];
                _remoteCommandRows[cmd.CommandId] = row;
            }

            row.Cells[2].Value = ToArabicCommandStatus(cmd.Status);
            row.Cells[4].Value = string.IsNullOrWhiteSpace(cmd.Result) ? "تم الرد" : cmd.Result;
            row.DefaultCellStyle.ForeColor = cmd.Status == "Executed" ? LightUiTheme.Success : LightUiTheme.Danger;
            _rtbRemoteLog?.AppendText($"\r\n[{DateTime.Now:HH:mm:ss}] نتيجة الأمر: {cmd.CommandType} [{cmd.CommandId}] => {ToArabicCommandStatus(cmd.Status)} | {cmd.Result}");
            _lastRemoteCommandType = cmd.CommandType ?? "—";
            _lastRemoteCommandStatus = ToArabicCommandStatus(cmd.Status);
            _lastRemoteCommandResult = string.IsNullOrWhiteSpace(cmd.Result) ? "تم الرد" : cmd.Result;
            _lastRemoteCommandAtLocal = DateTime.Now;
            AppendConnLog($"نتيجة أمر {cmd.CommandType}: {ToArabicCommandStatus(cmd.Status)}");
            RefreshLocalStateReading(false);
        }

        private static string ToArabicCommandStatus(string status)
        {
            switch (status)
            {
                case "Received": return "استُلم";
                case "Executed": return "نُفذ";
                case "Failed":   return "فشل";
                case "Sent":     return "أُرسل";
                case "Timeout":  return "مهلة";
                default:         return string.IsNullOrWhiteSpace(status) ? "—" : status;
            }
        }

        private void ShowLocalGhostFrame(byte[] jpg)
        {
            if (jpg == null || _pbRemoteScreen == null) return;
            using (var ms = new MemoryStream(jpg))
            using (var image = Image.FromStream(ms))
            {
                _pbRemoteScreen.Image?.Dispose();
                _pbRemoteScreen.Image = new Bitmap(image);
            }
            if (_lblRemoteStatus != null)
            {
                _lblRemoteStatus.Text = $"Ghost stream: {DateTime.Now:HH:mm:ss}";
                _lblRemoteStatus.ForeColor = LightUiTheme.Primary;
            }
            if (_lblFPS != null)
                _lblFPS.Text = $"{Math.Max(1, jpg.Length / 1024)} KB";
        }

        private void OnRequestScreen(object s = null, EventArgs e = null)
        {
            _lblRemoteStatus.Text = "Capturing screen...";
            CaptureAndDisplayScreenshot();
        }

        private void OnStopScreen(object s = null, EventArgs e = null)
        {
            _lblRemoteStatus.Text = "Opening screenshot folder...";
            var folder = Path.Combine(_config.BackupPath, "Screenshots");
            try
            {
                Directory.CreateDirectory(folder);
                System.Diagnostics.Process.Start("explorer.exe", folder);
                _lblRemoteStatus.Text = $"Screenshot folder: {Path.GetFileName(folder)}";
                _lblRemoteStatus.ForeColor = LightUiTheme.Muted;
            }
            catch (Exception ex)
            {
                AppendConnLog($"Cannot open screenshots folder: {ex.Message}", AppLogger.Level.Warning);
            }
        }

        // ==========================================
        // الإعدادات
        // ==========================================

        private void LoadSettingsToUI()
        {
            var normalizedType = AppConstants.NormalizeATMType(_config.ATM_Type);
            if (_txtServerIP    != null) _txtServerIP.Text    = _config.ServerIP;
            if (_txtServerPort  != null) _txtServerPort.Text  = _config.ServerPort.ToString();
            if (_txtATMID       != null) _txtATMID.Text       = _config.ATM_ID;
            if (_txtATMName     != null) _txtATMName.Text     = _config.ATM_Name;
            if (_txtSourcePath  != null) _txtSourcePath.Text  =
                string.IsNullOrWhiteSpace(_config.SourcePath)
                    ? AppConstants.GetDefaultSourcePath(normalizedType)
                    : _config.SourcePath;
            if (_txtBackupPath  != null) _txtBackupPath.Text  =
                string.IsNullOrWhiteSpace(_config.BackupPath)
                    ? AppConstants.GetDefaultBackupPath(normalizedType)
                    : _config.BackupPath;
            if (_cmbATMType     != null)
            {
                _cmbATMType.SelectedItem = normalizedType;
                if (_cmbATMType.SelectedIndex < 0 && _cmbATMType.Items.Count > 0)
                    _cmbATMType.SelectedIndex = 0;
            }
            if (_cmbNetworkType != null) _cmbNetworkType.SelectedItem = _config.NetworkType;
            if (_chkAutoConnect != null) _chkAutoConnect.Checked     = _config.AutoConnect;
            if (_chkEncrypt     != null) _chkEncrypt.Checked         = _config.Encrypt;
            if (_chkCompression != null) _chkCompression.Checked     = _config.Compress;
            if (_chkAutoBackup  != null) _chkAutoBackup.Checked      = _config.AutoBackup;
        }

        private void SaveSettingsFromUI()
        {
            if (_txtServerIP    != null) _config.ServerIP    = _txtServerIP.Text.Trim();
            if (_txtServerPort  != null && int.TryParse(_txtServerPort.Text, out var p)) _config.ServerPort = p;
            if (_txtATMID       != null) _config.ATM_ID      = _txtATMID.Text.Trim();
            if (_txtATMName     != null) _config.ATM_Name    = _txtATMName.Text.Trim();
            if (_txtSourcePath  != null) _config.SourcePath  = _txtSourcePath.Text.Trim();
            if (_txtBackupPath  != null) _config.BackupPath  = _txtBackupPath.Text.Trim();
            if (_cmbATMType     != null && _cmbATMType.SelectedItem != null)
                _config.ATM_Type = AppConstants.NormalizeATMType(_cmbATMType.SelectedItem.ToString());
            if (_cmbNetworkType != null && _cmbNetworkType.SelectedItem != null) _config.NetworkType = _cmbNetworkType.SelectedItem.ToString();
            if (_chkAutoConnect != null) _config.AutoConnect  = _chkAutoConnect.Checked;
            if (_chkEncrypt     != null) _config.Encrypt      = _chkEncrypt.Checked;
            if (_chkCompression != null) _config.Compress     = _chkCompression.Checked;
            if (_chkAutoBackup  != null) _config.AutoBackup   = _chkAutoBackup.Checked;
            if (string.IsNullOrWhiteSpace(_config.SourcePath))
                _config.SourcePath = AppConstants.GetDefaultSourcePath(_config.ATM_Type);
            if (string.IsNullOrWhiteSpace(_config.BackupPath))
                _config.BackupPath = AppConstants.GetDefaultBackupPath(_config.ATM_Type);
            _config.ApplyDefaults();
        }

        private void OnATMTypeChanged(object s, EventArgs e)
        {
            if (_cmbATMType?.SelectedItem == null || _txtSourcePath == null) return;
            var normalizedType = AppConstants.NormalizeATMType(_cmbATMType.SelectedItem.ToString());
            if (AppConstants.IsKnownDefaultSourcePath(_txtSourcePath.Text))
                _txtSourcePath.Text = AppConstants.GetDefaultSourcePath(normalizedType);
            if (_txtBackupPath != null && AppConstants.IsKnownDefaultBackupPath(_txtBackupPath.Text))
                _txtBackupPath.Text = AppConstants.GetDefaultBackupPath(normalizedType);
        }

        private void OnSaveSettings(object s = null, EventArgs e = null)
        {
            SaveSettingsFromUI();
            EnsureClientRuntimeFolders();
            _config.Save();
            PersistAgentConfigurationFromCurrentSettings();
            MessageBox.Show("تم حفظ الإعدادات بنجاح.", "حفظ", MessageBoxButtons.OK, MessageBoxIcon.Information);
            Text = $"EJLive Enterprise Client — {_config.ATM_ID}";
        }

        private void OnLoadAgentConfig(object s = null, EventArgs e = null)
        {
            _agentConfig = AgentConfigurationXmlService.LoadOrCreate(_config);
            PopulateAgentConfigGrid();
            SetAgentConfigStatus("تم تحميل AgentConf.xml من القرص.", false);
        }

        private void OnApplyAgentConfig(object s = null, EventArgs e = null)
        {
            _agentConfig = ReadAgentConfigurationFromGrid();
            ApplyAgentConfigurationToRuntime(_agentConfig);
            LoadSettingsToUI();
            SetAgentConfigStatus("تم تطبيق القيم على إعدادات الفورم. اضغط حفظ لتثبيتها على القرص.", false);
        }

        private void OnSaveAgentConfig(object s = null, EventArgs e = null)
        {
            _agentConfig = ReadAgentConfigurationFromGrid();
            AgentConfigurationXmlService.Save(_agentConfig);
            ApplyAgentConfigurationToRuntime(_agentConfig);
            _config.Save();
            LoadSettingsToUI();
            PopulateAgentConfigGrid();
            SetAgentConfigStatus("تم حفظ AgentConf.xml وتحديث إعدادات العميل.", false);
        }

        private void OnOpenAgentConfigFolder(object s = null, EventArgs e = null)
        {
            try
            {
                var path = _agentConfig?.ConfigPath ?? AgentConfigurationXmlService.DefaultPath;
                var folder = Path.GetDirectoryName(path);
                if (!string.IsNullOrWhiteSpace(folder))
                {
                    Directory.CreateDirectory(folder);
                    System.Diagnostics.Process.Start("explorer.exe", folder);
                }
            }
            catch (Exception ex)
            {
                SetAgentConfigStatus($"تعذر فتح مجلد الإعداد: {ex.Message}", true);
            }
        }

        private void PersistAgentConfigurationFromCurrentSettings()
        {
            _agentConfig = AgentConfigurationXmlService.FromAppConfig(_config, _agentConfig?.ConfigPath);
            AgentConfigurationXmlService.Save(_agentConfig);
            PopulateAgentConfigGrid();
        }

        private void ApplyAgentConfigurationToRuntime(AgentConfigurationRecord record)
        {
            if (record == null) return;
            _config = AgentConfigurationXmlService.LoadAppConfig(_config, record.ConfigPath);
            _config.ApplyDefaults();
            EnsureClientRuntimeFolders();
            Text = $"EJLive Enterprise Client — {_config.ATM_ID}";
            if (_atmInfo != null)
            {
                _atmInfo.ATM_ID = _config.ATM_ID;
                _atmInfo.ATM_Name = _config.ATM_Name;
                _atmInfo.ATM_Type = _config.ATM_Type;
                _atmInfo.NetworkType = _config.NetworkType;
                _atmInfo.ServerIP = _config.ServerIP;
                _atmInfo.ServerPort = _config.ServerPort;
            }
        }

        private void PopulateAgentConfigGrid()
        {
            if (_dgvAgentConfig == null) return;
            if (_agentConfig == null)
                _agentConfig = AgentConfigurationXmlService.LoadOrCreate(_config);

            _dgvAgentConfig.Rows.Clear();
            var flattened = AgentConfigurationXmlService.Flatten(_agentConfig);
            foreach (var pair in flattened)
                _dgvAgentConfig.Rows.Add(pair.Key, pair.Value ?? string.Empty, DescribeAgentConfigKey(pair.Key));

            foreach (var pair in _agentConfig.Parameters)
                if (!flattened.ContainsKey(pair.Key))
                    _dgvAgentConfig.Rows.Add(pair.Key, pair.Value ?? string.Empty, "Parameter مخصص من AgentConf.xml");

            if (_lblAgentConfigPath != null)
                _lblAgentConfigPath.Text = $"AgentConf.xml: {_agentConfig.ConfigPath ?? AgentConfigurationXmlService.DefaultPath}";
        }

        private AgentConfigurationRecord ReadAgentConfigurationFromGrid()
        {
            var record = _agentConfig ?? AgentConfigurationXmlService.FromAppConfig(_config);
            record.Parameters = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

            foreach (DataGridViewRow row in _dgvAgentConfig.Rows)
            {
                if (row.IsNewRow) continue;
                var key = Convert.ToString(row.Cells[0].Value)?.Trim();
                var value = Convert.ToString(row.Cells[1].Value)?.Trim() ?? string.Empty;
                if (string.IsNullOrWhiteSpace(key)) continue;

                switch (key)
                {
                    case "AgentId":
                        record.AgentId = value;
                        break;
                    case "TerminalId":
                        record.TerminalId = value;
                        break;
                    case "TerminalName":
                        record.Parameters["TerminalName"] = value;
                        break;
                    case "Vendor":
                        record.Parameters["Vendor"] = AppConstants.NormalizeATMType(value);
                        break;
                    case "Model":
                        record.Parameters["Model"] = value;
                        break;
                    case "NetworkType":
                        record.Parameters["NetworkType"] = value;
                        break;
                    case "ServerHost":
                        record.ServerHost = value;
                        break;
                    case "ServerPort":
                        if (int.TryParse(value, out var port)) record.ServerPort = port;
                        break;
                    case "SourcePath":
                        record.SourcePath = value;
                        break;
                    case "BackupPath":
                        record.BackupPath = value;
                        break;
                    case "DurableSyncEnabled":
                        if (bool.TryParse(value, out var durable)) record.DurableSyncEnabled = durable;
                        break;
                    case "AckRequired":
                        if (bool.TryParse(value, out var ack)) record.AckRequired = ack;
                        break;
                    case "DedupEnabled":
                        if (bool.TryParse(value, out var dedup)) record.DedupEnabled = dedup;
                        break;
                    case "AutoConnect":
                        record.Parameters["AutoConnect"] = value;
                        break;
                    default:
                        record.Parameters[key] = value;
                        break;
                }
            }

            if (string.IsNullOrWhiteSpace(record.ConfigPath))
                record.ConfigPath = AgentConfigurationXmlService.DefaultPath;
            if (string.IsNullOrWhiteSpace(record.AgentId))
                record.AgentId = record.TerminalId;
            if (string.IsNullOrWhiteSpace(record.TerminalId))
                record.TerminalId = record.AgentId;
            if (!record.Parameters.ContainsKey("TerminalName"))
                record.Parameters["TerminalName"] = _config.ATM_Name;
            if (!record.Parameters.ContainsKey("Vendor"))
                record.Parameters["Vendor"] = AppConstants.NormalizeATMType(_config.ATM_Type);
            if (!record.Parameters.ContainsKey("NetworkType"))
                record.Parameters["NetworkType"] = _config.NetworkType;
            if (!record.Parameters.ContainsKey("AutoConnect"))
                record.Parameters["AutoConnect"] = _config.AutoConnect.ToString().ToLowerInvariant();

            return record;
        }

        private void SetAgentConfigStatus(string message, bool isError)
        {
            if (_lblAgentConfigStatus == null) return;
            _lblAgentConfigStatus.Text = message;
            _lblAgentConfigStatus.ForeColor = isError ? LightUiTheme.Danger : LightUiTheme.Success;
        }

        private static string DescribeAgentConfigKey(string key)
        {
            switch (key)
            {
                case "AgentId": return "هوية الـ Agent المستخدمة في التشغيل والتدقيق";
                case "TerminalId": return "ربط الصراف بالخادم ومركز المراقبة";
                case "TerminalName": return "اسم العرض داخل الواجهات";
                case "Vendor": return "نوع الصراف لاختيار قواعد الجورنال والمسارات";
                case "Model": return "موديل الجهاز لربط MAPPING.xml لاحقًا";
                case "NetworkType": return "سياسة retry/backoff للشبكة";
                case "ServerHost": return "عنوان الخادم";
                case "ServerPort": return "منفذ TCP التشغيلي";
                case "SourcePath": return "مصدر ملفات الجورنال";
                case "BackupPath": return "الأرشفة المحلية واللقطات";
                case "DurableSyncEnabled": return "تفعيل طابور مزامنة مستمر";
                case "AckRequired": return "اشتراط ACK قبل اعتبار الملف مرسلًا";
                case "DedupEnabled": return "منع التكرار بالـ checksum";
                case "AutoConnect": return "الاتصال تلقائيًا عند التشغيل";
                default: return "Parameter مخصص";
            }
        }

        private void OnBrowseSource(object s = null, EventArgs e = null)
        {
            using var dlg = new FolderBrowserDialog { Description = "اختر مجلد الجورنال" };
            if (dlg.ShowDialog() == DialogResult.OK) _txtSourcePath.Text = dlg.SelectedPath;
        }

        private void OnBrowseBackup(object s = null, EventArgs e = null)
        {
            using var dlg = new FolderBrowserDialog { Description = "اختر مجلد النسخ الاحتياطي" };
            if (dlg.ShowDialog() == DialogResult.OK) _txtBackupPath.Text = dlg.SelectedPath;
        }

        private void OnLocalChangePassword(object s = null, EventArgs e = null)
        {
            if (_txtNewPassword.Text != _txtConfirmPassword.Text)
            {
                MessageBox.Show("كلمة السر الجديدة غير مطابقة للتأكيد.", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            if (_txtNewPassword.Text.Length < 6)
            {
                MessageBox.Show("كلمة السر يجب أن تكون 6 أحرف على الأقل.", "خطأ", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }
            _config.HashedPassword = SecurityHelper.HashPassword(_txtNewPassword.Text);
            _config.Save();
            MessageBox.Show("تم تغيير كلمة المرور بنجاح.", "نجاح", MessageBoxButtons.OK, MessageBoxIcon.Information);
            _txtCurrentPassword.Text = _txtNewPassword.Text = _txtConfirmPassword.Text = "";
        }

        // ==========================================
        // التحديث الدوري
        // ==========================================

        private void InitializeTimer()
        {
            _uiTimer = new System.Windows.Forms.Timer { Interval = 1000 };
            _uiTimer.Tick += (s, e) =>
            {
                _lblTime.Text = DateTime.Now.ToString("HH:mm:ss");
                if (_networkManager != null)
                {
                    _lblBytesSent.Text = $"مُرسل: {_networkManager.TotalBytesSent / 1024.0:F1} KB";
                    _lblBytesRecv.Text = $"مُستلم: {_networkManager.TotalBytesReceived / 1024.0:F1} KB";
                }
                if (_outbox != null) _lblQueueCount.Text = $"الطابور: {_outbox.PendingCount} ملف";
                UpdateServiceStatuses();
                _localStateTick++;
                RefreshLocalStateReading(_localStateTick % 15 == 0);
            };
            _uiTimer.Start();
        }

        // ==========================================
        // مساعدات الواجهة
        // ==========================================

        private void AppendConnLog(string text, AppLogger.Level level = AppLogger.Level.Info)
        {
            if (_rtbConnLog == null || IsDisposed) return;
            if (_rtbConnLog.InvokeRequired) { _rtbConnLog.Invoke(new Action(() => AppendConnLog(text, level))); return; }
            text = CleanRuntimeText(text);
            _rtbConnLog.SelectionColor = level >= AppLogger.Level.Error ? Color.FromArgb(180, 35, 24)
                                       : level == AppLogger.Level.Warning ? Color.FromArgb(180, 100, 0)
                                       : LightUiTheme.Text;
            var prefix = text.StartsWith("[") ? "" : $"[{DateTime.Now:HH:mm:ss}] ";
            _rtbConnLog.AppendText($"{prefix}{text}\n");
            _rtbConnLog.ScrollToCaret();
        }

        private Button MakeButton(string text, Color backColor, Action action, int width = 130) =>
            MakeButton(text, backColor, (s, e) => action?.Invoke(), width);

        private Button MakeButton(string text, Color backColor, EventHandler onClick, int width)
        {
            var btn = new Button
            {
                Text = text,
                Width = Math.Max(width, 44),
                MinimumSize = new Size(Math.Max(width, 44), 34),
                Height = 34,
                BackColor = backColor,
                ForeColor = Color.White,
                FlatStyle = FlatStyle.Flat,
                Font = new Font("Segoe UI", 8.7f, FontStyle.Bold),
                Margin = new Padding(5, 3, 5, 3),
                Cursor = Cursors.Hand,
                AutoEllipsis = true,
                TextAlign = ContentAlignment.MiddleCenter,
                UseVisualStyleBackColor = false
            };
            btn.Tag = backColor;
            btn.FlatAppearance.BorderSize = 0;
            btn.Click += onClick;
            LightUiTheme.StyleButton(btn, backColor);
            return btn;
        }

        private void SetButtonVisual(Button btn, Color activeColor, bool active)
        {
            if (btn == null) return;
            btn.Enabled = true;
            if (active)
            {
                LightUiTheme.StyleButton(btn, activeColor);
                btn.FlatAppearance.BorderSize = 0;
            }
            else
            {
                btn.BackColor = LightUiTheme.SurfaceAlt;
                btn.ForeColor = LightUiTheme.Muted;
                btn.FlatStyle = FlatStyle.Flat;
                btn.FlatAppearance.BorderSize = 1;
                btn.FlatAppearance.BorderColor = LightUiTheme.Border;
                btn.UseVisualStyleBackColor = false;
                btn.Cursor = Cursors.Default;
            }
        }

        private void ApplyClientVisualCorrections()
        {
            if (_tabMain != null)
            {
                _tabMain.DrawMode = TabDrawMode.Normal;
                _tabMain.SizeMode = TabSizeMode.Normal;
                _tabMain.ItemSize = new Size(150, 32);
                _tabMain.Font = new Font("Segoe UI", 9f, FontStyle.Bold);
                _tabMain.RightToLeft = RightToLeft.No;
                _tabMain.RightToLeftLayout = false;
            }

            foreach (var box in new[] { _rtbConnLog, _rtbJournal, _rtbRemoteLog })
            {
                if (box == null) continue;
                box.BackColor = LightUiTheme.Surface;
                box.ForeColor = LightUiTheme.Text;
                box.Font = new Font("Segoe UI", box == _rtbJournal ? 9.5f : 9f);
                box.BorderStyle = BorderStyle.FixedSingle;
                box.DetectUrls = false;
                box.RightToLeft = RightToLeft.No;
            }

            _lblConnText.ForeColor = LightUiTheme.Danger;
            _lblConnIndicator.ForeColor = LightUiTheme.Muted;
            _lblSessionId.ForeColor = LightUiTheme.Muted;
            _lblLatency.ForeColor = LightUiTheme.Muted;
            _lblConnProgress.ForeColor = LightUiTheme.Primary;
            _lblStatus.ForeColor = LightUiTheme.Danger;
            _lblSpeed.ForeColor = LightUiTheme.Muted;
            _lblSyncState.ForeColor = LightUiTheme.Muted;
            _lblTime.ForeColor = LightUiTheme.Muted;

            SetButtonVisual(_btnConnect, LightUiTheme.Success, true);
            SetButtonVisual(_btnDisconnect, LightUiTheme.Danger, false);
            SetButtonVisual(_btnRequestScreen, LightUiTheme.Primary, true);
            SetButtonVisual(_btnStopScreen, LightUiTheme.Danger, false);
        }

        private void LayoutMainRegions()
        {
            if (_tabMain == null || _menuStrip == null || _statusStrip == null) return;
            var top = _menuStrip.Height;
            var bottom = _statusStrip.Height;
            _tabMain.Bounds = new Rectangle(0, top, ClientSize.Width, Math.Max(0, ClientSize.Height - top - bottom));
        }

        private string CleanRuntimeText(string text)
        {
            if (string.IsNullOrEmpty(text)) return string.Empty;
            return text
                .Replace("✅", "")
                .Replace("🔄", "")
                .Replace("📁", "")
                .Replace("📡", "")
                .Replace("♻️", "")
                .Replace("⚡", "")
                .Replace("🔑", "")
                .Replace("👁️", "")
                .Replace("⟳", "")
                .Replace("✓", "")
                .Replace("✗", "")
                .Replace("✕", "")
                .Replace("→", "-")
                .Replace("←", "-")
                .Trim();
        }

        private TextBox MakeInput(string placeholder, int width) => new TextBox { Width = width, Text = placeholder, BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text, BorderStyle = BorderStyle.FixedSingle, Margin = new Padding(4) };
        private Label MakeLabel(string text) => new Label { Text = text, AutoSize = true, ForeColor = LightUiTheme.Text, TextAlign = ContentAlignment.MiddleLeft, Padding = new Padding(0, 6, 0, 0) };
        private Label MakeMeta(string label, string value)
        {
            var lbl = new Label { AutoSize = true, ForeColor = LightUiTheme.Text, Margin = new Padding(0, 0, 24, 0) };
            lbl.Text = $"{label} {value}";
            return lbl;
        }

        private CheckBox MakeCheckbox(string text, bool chk = false) => new CheckBox { Text = text, Checked = chk, ForeColor = LightUiTheme.Text, AutoSize = true, Margin = new Padding(8, 8, 8, 0) };

        private ComboBox MakeCombo(string[] items, int width)
        {
            var cb = new ComboBox { Width = width, DropDownStyle = ComboBoxStyle.DropDownList, BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text, FlatStyle = FlatStyle.System, Margin = new Padding(4) };
            cb.Items.AddRange(items);
            if (cb.Items.Count > 0) cb.SelectedIndex = 0;
            return cb;
        }

        private DataGridView CreateDataGrid()
        {
            var dgv = new DataGridView
            {
                Dock = DockStyle.Fill,
                BackgroundColor = LightUiTheme.Surface,
                GridColor = LightUiTheme.Border,
                ForeColor = LightUiTheme.Text,
                ColumnHeadersDefaultCellStyle = new DataGridViewCellStyle { BackColor = LightUiTheme.Header, ForeColor = LightUiTheme.Text, Font = new Font("Segoe UI", 8.5f, FontStyle.Bold) },
                DefaultCellStyle = new DataGridViewCellStyle { BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text, SelectionBackColor = LightUiTheme.Selection, SelectionForeColor = Color.White },
                SelectionMode = DataGridViewSelectionMode.FullRowSelect, MultiSelect = false, ReadOnly = true, AllowUserToAddRows = false, AllowUserToDeleteRows = false, RowHeadersVisible = false, BorderStyle = BorderStyle.FixedSingle, RowTemplate = { Height = 28 }
            };
            LightUiTheme.ApplyDataGrid(dgv);
            return dgv;
        }

