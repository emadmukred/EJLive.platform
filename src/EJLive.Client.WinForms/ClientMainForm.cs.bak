            _rtbRemoteLog = new RichTextBox { Height = 110, Dock = DockStyle.Bottom, BackColor = LightUiTheme.Surface, ForeColor = LightUiTheme.Text, Font = new Font("Segoe UI", 8.8f), ReadOnly = true, BorderStyle = BorderStyle.FixedSingle, RightToLeft = RightToLeft.No };
            remotePanel.Controls.AddRange(new Control[] { remoteGroup, _rtbRemoteLog });
            split.Panel1.Controls.Add(remotePanel);

            var opsPanel = new Panel { Dock = DockStyle.Fill, BackColor = LightUiTheme.Window, Padding = new Padding(10, 0, 0, 0) };
            var servicesGroup = new GroupBox
            {
                Text = "خدمات نظام ويندوز",
