<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\EJLive.Application\EJLive.Application.csproj" />
    <ProjectReference Include="..\EJLive.Client.WinForms\EJLive.Client.WinForms.csproj" />
    <ProjectReference Include="..\EJLive.Client.Service\EJLive.Client.Service.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>EJLive.Installer</AssemblyName>
    <RootNamespace>EJLive.Installer.WinForms</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
      <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <Target Name="CopyClientServicePayload" AfterTargets="Build">
    <ItemGroup>
      <ClientServicePayload Include="..\EJLive.Client.Service\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ClientServicePayload)"
          DestinationFiles="@(ClientServicePayload->'$(TargetDir)payload\ClientService\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="@(ClientServicePayload->'$(TargetDir)payload\ClientService\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Compile map: generated by tools/inventory/ejlive_inventory.py curation.
         Explicit list, no globs: every source file in this project is either compiled here
         or linked reference under src/_reference/. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Compile map: generated by tools/inventory/ejlive_inventory.py curation.
         Explicit list, no globs: every source file in this project is either compiled here
         or linked reference under src/_reference/. -->
    <Compile Include="InstallerAutomationRunner.cs" />
    <Compile Include="InstallerForm.cs" />
    <Compile Include="InstallerOperationalSecurityService.cs" />
    <Compile Include="InstallerStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
