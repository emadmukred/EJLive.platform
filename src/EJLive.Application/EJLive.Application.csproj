<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>EJLive.Application</AssemblyName>
    <RootNamespace>EJLive.Application</RootNamespace>
      <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EJLive.Business\EJLive.Business.csproj" />
    <ProjectReference Include="..\EJLive.Core\EJLive.Core.csproj" />
    <ProjectReference Include="..\EJLive.Shared\EJLive.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile map: generated by tools/inventory/ejlive_inventory.py curation.
         Explicit list, no globs: every source file in this project is either compiled here
         or linked reference under src/_reference/. -->
    <Compile Include="EJLiveApplicationHost.cs" />
    <Compile Include="Installation\InstallerAutomationRunner.cs" />
    <Compile Include="Installation\InstallerOperationalSecurityService.cs" />
    <Compile Include="Installation\InstallerPlatformServices.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
