<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>EJLive.Business</AssemblyName>
    <RootNamespace>EJLive.Business</RootNamespace>
      <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EJLive.Core\EJLive.Core.csproj" />
    <ProjectReference Include="..\EJLive.Shared\EJLive.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile map: generated by tools/inventory/ejlive_inventory.py curation.
         Explicit list, no globs: every source file in this project is either compiled here
         or linked reference under src/_reference/. BusinessAdapters.cs and
         UnifiedServiceGateway.cs were archived under src/_reference/uncompiled/EJLive.Business/
         (Wave 2 / D-01) — their `public partial class …` bodies lived in
         namespace EJLive.Core.Services and duplicated Core's owners across
         assemblies (CS0433 for any project that references both). Their
         functionality is owned by Core and re-declared in EJLive.Business as
         extension methods / adapters when a Business-side surface is needed. -->
    <Compile Include="OriginalSourceCatalog.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="StableBusinessRuntime.cs" />
    <Compile Include="UnifiedBusinessRuntime.cs" />
    <Compile Include="UnifiedClientServiceSupervisor.cs" />
    <Compile Include="UnifiedFileBindingService.cs" />
    <Compile Include="UnifiedFleetReadinessService.cs" />
    <Compile Include="UnifiedJournalEvidenceAnalyzer.cs" />
    <Compile Include="UnifiedJournalStorageService.cs" />
    <Compile Include="UnifiedOperationalFusionService.cs" />
    <Compile Include="UnifiedRemoteCommandOrchestrator.cs" />
    <Compile Include="UnifiedRemoteCommandPolicy.cs" />
  </ItemGroup>
</Project>
