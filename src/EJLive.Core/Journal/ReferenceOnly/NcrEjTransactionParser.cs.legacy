using System; using System.Linq; using EJLive.Core.Journal; namespace EJLive.Core.Journal { public class NcrEjTransactionParser : IEjTransactionParser { public string Vendor => "NCR"; public bool CanParse(EjParseContext ctx) { return ctx.Lines != null && ctx.Lines.Any(l => l != null && l.Contains("*TRANSACTION START*")); } public EjParseResult Parse(EjParseContext ctx) { var r = new EjParseResult { TotalLines = ctx.Lines?.Length ?? 0, OverallConfidence = ConfidenceScore.Low }; if (ctx?.Lines == null) return r; EjTransaction tx = null; for (int i = 0; i < ctx.Lines.Length; i++) { var l = ctx.Lines[i] ?? ""; if (l.Contains("*TRANSACTION START*")) { tx = new EjTransaction { RawStartLine = i + 1, ATM_ID = ctx.ATM_ID, Vendor = Vendor }; } else if (l.Contains("TRANSACTION END") && tx != null) { tx.RawEndLine = i + 1; r.Transactions.Add(tx); tx = null; } else if (tx != null) { if (l.IndexOf("STAN:", StringComparison.OrdinalIgnoreCase) >= 0) { var idx = l.IndexOf("STAN:", StringComparison.OrdinalIgnoreCase); tx.STAN = l.Substring(idx + 5).Trim(); } else if (l.IndexOf("RRN:", StringComparison.OrdinalIgnoreCase) >= 0) { var idx2 = l.IndexOf("RRN:", StringComparison.OrdinalIgnoreCase); tx.RRN = l.Substring(idx2 + 4).Trim(); } else if (l.IndexOf("AMOUNT:", StringComparison.OrdinalIgnoreCase) >= 0) { var idx3 = l.IndexOf("AMOUNT:", StringComparison.OrdinalIgnoreCase); decimal amt; if (decimal.TryParse(l.Substring(idx3 + 7).Trim(), out amt)) tx.Amount = amt; } else if (l.IndexOf("NOTES PRESENTED", StringComparison.OrdinalIgnoreCase) >= 0) { tx.EvidenceMarkers.Add("NOTES_PRESENTED"); } else if (l.IndexOf("NOTES TAKEN", StringComparison.OrdinalIgnoreCase) >= 0) { tx.EvidenceMarkers.Add("NOTES_TAKEN"); } } else { r.UnknownLines.Add(l); } } if (tx != null) r.Transactions.Add(tx); r.ParsedTransactions = r.Transactions.Count; if (r.ParsedTransactions > 0) r.OverallConfidence = ConfidenceScore.Medium; return r; } } }