<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Read-only archive of every demoted source file. It compiles exactly one
    marker type; everything else is `<None>` so the legacy tree stays browsable
    in Visual Studio without ever entering a compile map. This is the mechanism
    that keeps 628k lines of legacy source inspectable and non-authoritative.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EJLive.LegacyReference</AssemblyName>
    <RootNamespace>EJLive.LegacyReference</RootNamespace>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LegacyReferenceMarker.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\_reference\**\*.cs"
          Link="_reference\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\_reference\**\*.xaml"
          Link="_reference\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\_reference\**\*.resx"
          Link="_reference\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\_reference\**\*.csproj"
          Link="_reference\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\_reference\**\*.sql"
          Link="_reference\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\_reference\**\*.config"
          Link="_reference\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(SolutionRoot)README.md" Link="root\README.md" />
    <None Include="$(SolutionRoot)Directory.Build.props" Link="root\Directory.Build.props" />
    <None Include="$(SolutionRoot)EJLive.Platform.slnx" Link="root\EJLive.Platform.slnx" />
  </ItemGroup>
</Project>
