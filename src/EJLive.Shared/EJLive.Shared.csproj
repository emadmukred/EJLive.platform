<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>EJLive.Shared</AssemblyName>
    <RootNamespace>EJLive.Shared</RootNamespace>
      <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Seven files left this project: each referenced EJLive.Core or System.Windows.Forms,
         which an L0 primitives assembly cannot compile (CS0234). They are now
         src/EJLive.Core/Shared/** and documented in docs/ANALYSIS-FINDINGS.md (E-17).
         Logger.cs went to src/_reference/uncompiled/ instead (E-18): it is a second log-record
         model whose members belong to a nested AppLogger.Level enum this assembly never declared
         (CS0426), while AppLogger.cs is the one every consumer actually uses. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile map: generated by tools/inventory/ejlive_inventory.py curation.
         Explicit list, no globs: every source file in this project is either compiled here
         or linked reference under src/_reference/. -->
    <Compile Include="AppConfig.cs" />
    <Compile Include="AppConstants.cs" />
    <Compile Include="AppLogger.cs" />
    <Compile Include="Configuration\AppConfig.cs" />
    <Compile Include="DateTimeHelper.cs" />
    <Compile Include="MonitoringState.cs" />
    <Compile Include="MonitoringStateStore.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="RetryPolicy.cs" />
    <Compile Include="SecurityConfig.cs" />
    <Compile Include="SecurityHelper.cs" />
  </ItemGroup>
</Project>
