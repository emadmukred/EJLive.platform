    <ProjectReference Include="..\EJLive.Monitoring.WinForms\EJLive.Monitoring.WinForms.csproj" />
    <ProjectReference Include="..\EJLive.Server\EJLive.Server.csproj" />
    <ProjectReference Include="..\EJLive.Server.WinForms\EJLive.Server.WinForms.csproj" />
    <ProjectReference Include="..\EJLive.Shared\EJLive.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.118" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile map: generated by tools/inventory/ejlive_inventory.py curation.
